# Brand strings — override here without touching code.
# Defaults are baked into src/site.config.ts for production.

# Production canonical URL. Used for OG tags, canonical links, sitemap.
# .pages.dev values are auto-rejected and fall back to default.
PUBLIC_SITE_URL="https://alwaysontopnotes.com"

# Bare domain (no protocol). Shown in trust copy, footers.
PUBLIC_SITE_DOMAIN="alwaysontopnotes.com"

# Brand name (display).
PUBLIC_SITE_NAME="AlwaysOnTopNotes"
PUBLIC_SITE_SHORT_NAME="AlwaysOnTopNotes"

# Tagline shown in hero + OG cards. 3-5 words.
PUBLIC_SITE_TAGLINE="Sticky notes that float over every app."

# Meta description — under 160 chars so Google doesn't truncate.
PUBLIC_SITE_DESCRIPTION="Sticky notes that float over every app via Document Picture-in-Picture. Free forever, no install, no signup. Notes stay on your device."

# Public author + contact (shown in footer + /contact + /privacy-policy).
PUBLIC_SITE_AUTHOR="Shrestha Tripathi"
PUBLIC_SITE_CONTACT_EMAIL="shrestha.tripathi@gmail.com"

# Locale.
PUBLIC_SITE_LOCALE="en-US"

# GitHub repo URL (surfaced on /contact + /about + /privacy).
PUBLIC_SITE_GITHUB_REPO="https://github.com/shrestha-tripathi/alwaysontopnotes"

# Jurisdiction whose law governs Terms.
PUBLIC_SITE_JURISDICTION="India"

# Google Analytics 4 Measurement ID. Empty string disables.
# Only injected in production builds (localhost dev never pollutes).
PUBLIC_GA_MEASUREMENT_ID="G-0BQXBH4REP"
