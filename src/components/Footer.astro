---
import { site } from "../site.config";

const year = new Date().getFullYear();
---

<footer class="mt-32 border-t border-[var(--color-border)] py-12">
  <div class="mx-auto max-w-[1200px] px-6 md:px-12">
    <div class="grid gap-10 md:grid-cols-[2fr_1fr_1fr_1fr]">
      {/* Brand */}
      <div>
        <a
          href="/"
          class="inline-flex items-center gap-2.5 no-underline hover:no-underline"
          aria-label={`${site.name} — home`}
        >
          <svg
            width="24"
            height="24"
            viewBox="0 0 32 32"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >
            <rect
              x="4"
              y="6"
              width="24"
              height="24"
              rx="2"
              fill="var(--color-accent)"
              transform="rotate(-3 16 18)"
            />
          </svg>
          <span class="font-semibold tracking-tight text-[var(--color-fg)]">
            {site.name}
          </span>
        </a>
        <p class="mt-3 max-w-sm text-sm text-[var(--color-fg-muted)]">
          {site.tagline}
        </p>
        <p class="mt-2 text-xs text-[var(--color-fg-subtle)]">
          Notes stay on your device. Nothing uploads.
        </p>
      </div>

      {/* Product */}
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-[var(--color-fg-subtle)]">
          Product
        </h3>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a href="/app" class="text-[var(--color-fg-muted)] hover:text-[var(--color-fg)] no-underline hover:no-underline">Open notes</a></li>
          <li><a href="/how-it-works" class="text-[var(--color-fg-muted)] hover:text-[var(--color-fg)] no-underline hover:no-underline">How it works</a></li>
          <li><a href="/compare" class="text-[var(--color-fg-muted)] hover:text-[var(--color-fg)] no-underline hover:no-underline">Compare</a></li>
          <li><a href="/install" class="text-[var(--color-fg-muted)] hover:text-[var(--color-fg)] no-underline hover:no-underline">Install as app</a></li>
        </ul>
      </div>

      {/* Help */}
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-[var(--color-fg-subtle)]">
          Help
        </h3>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a href="/faq" class="text-[var(--color-fg-muted)] hover:text-[var(--color-fg)] no-underline hover:no-underline">FAQ</a></li>
          <li><a href="/contact" class="text-[var(--color-fg-muted)] hover:text-[var(--color-fg)] no-underline hover:no-underline">Contact</a></li>
          <li><a href={site.githubRepo} target="_blank" rel="noopener" class="text-[var(--color-fg-muted)] hover:text-[var(--color-fg)] no-underline hover:no-underline">GitHub</a></li>
        </ul>
      </div>

      {/* Legal */}
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-[var(--color-fg-subtle)]">
          Legal
        </h3>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a href="/about" class="text-[var(--color-fg-muted)] hover:text-[var(--color-fg)] no-underline hover:no-underline">About</a></li>
          <li><a href="/privacy-policy" class="text-[var(--color-fg-muted)] hover:text-[var(--color-fg)] no-underline hover:no-underline">Privacy</a></li>
          <li><a href="/terms" class="text-[var(--color-fg-muted)] hover:text-[var(--color-fg)] no-underline hover:no-underline">Terms</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-10 flex flex-col gap-2 border-t border-[var(--color-border)] pt-6 text-xs text-[var(--color-fg-subtle)] md:flex-row md:items-center md:justify-between">
      <p>
        © {year} {site.author} · MIT license · Your notes never leave your
        device · No signup, no nonsense
      </p>
      <p>
        Part of the{" "}
        <a
          href="https://livecaptionit.com"
          class="prose-link text-[var(--color-fg-muted)] hover:text-[var(--color-fg)]"
          target="_blank"
          rel="noopener"
        >LiveCaptionIt</a>{" "}
        family — browser-native Document PiP apps.
      </p>
    </div>
  </div>
</footer>
