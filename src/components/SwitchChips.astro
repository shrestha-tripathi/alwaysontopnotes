---
/**
 * SwitchChips — the 7-advantage grid.
 *
 * Each chip = one frustration with native sticky notes + our specific answer.
 * Hover state = subtle lift + accent-colored border glow.
 *
 * No JS. Pure CSS. Both themes.
 */
const advantages = [
  {
    pain: "Hides behind Zoom",
    answer: "Floats over every fullscreen app",
    detail: "Document Picture-in-Picture API gives us a real OS-level always-on-top window. Survives screen share, fullscreen, virtual desktops.",
    icon: "layers",
  },
  {
    pain: "Mac-only or Windows-only",
    answer: "Works on every desktop",
    detail: "Mac, Windows, Linux, Chromebook — anything with Chrome 116+ or Edge. Your notes follow you across machines.",
    icon: "globe",
  },
  {
    pain: "Cloud sync = upload",
    answer: "Nothing leaves your device",
    detail: "Notes live in your browser's IndexedDB, on your device. Not on our server. We can't read them. There IS no server.",
    icon: "shield",
  },
  {
    pain: "Plain text only (Windows)",
    answer: "Full rich text + markdown",
    detail: "Headings, lists, checkboxes, code blocks, links. Type markdown shortcuts (`# `, `- `, `[ ] `) and they render instantly.",
    icon: "type",
  },
  {
    pain: "No export, locked in",
    answer: "One-click markdown export",
    detail: "Export any note — or all notes — as a markdown ZIP. Your data outlives any browser, any OS reinstall.",
    icon: "download",
  },
  {
    pain: "Mouse-only workflow",
    answer: "Keyboard-first, Cmd+K palette",
    detail: "Press N for new note, / to search, Cmd+K for everything. Press ? to see all shortcuts. Vim users will feel at home.",
    icon: "keyboard",
  },
  {
    pain: "\"Trust us\" privacy",
    answer: "MIT open source, audit it",
    detail: "Every line on GitHub. Self-host if you want. The privacy claim is verifiable, not a marketing line.",
    icon: "code",
  },
];

// Inline SVG icon paths (no icon library = no JS, no extra request)
const iconPaths: Record<string, string> = {
  layers: `<polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline>`,
  globe: `<circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>`,
  shield: `<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>`,
  type: `<polyline points="4 7 4 4 20 4 20 7"></polyline><line x1="9" y1="20" x2="15" y2="20"></line><line x1="12" y1="4" x2="12" y2="20"></line>`,
  download: `<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line>`,
  keyboard: `<rect x="2" y="4" width="20" height="16" rx="2" ry="2"></rect><path d="M6 8h.001M10 8h.001M14 8h.001M18 8h.001M6 12h.001M10 12h.001M14 12h.001M18 12h.001M7 16h10"></path>`,
  code: `<polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline>`,
};
---

<section id="why-switch" class="mx-auto max-w-[1200px] px-6 py-16 md:px-12 md:py-24">
  <div class="max-w-2xl">
    <span
      class="text-xs font-semibold uppercase tracking-wider text-[var(--color-accent-strong)]"
    >
      Why switch
    </span>
    <h2
      class="mt-3 text-3xl font-bold tracking-tight text-[var(--color-fg)] md:text-4xl lg:text-5xl"
    >
      Seven things native sticky notes
      <span class="text-[var(--color-fg-muted)]">structurally can't do.</span>
    </h2>
    <p class="mt-5 text-base leading-relaxed text-[var(--color-fg-muted)] md:text-lg">
      Windows Sticky Notes and macOS Stickies have been around for 20+ years.
      They still can't do these. Not because the teams are lazy — because the
      architecture doesn't allow it.
    </p>
  </div>

  <ul
    class="mt-14 grid gap-4 md:grid-cols-2 lg:grid-cols-3 lg:gap-5"
    role="list"
  >
    {advantages.map((a) => (
      <li
        class="group relative flex flex-col gap-3 rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-subtle)] p-6 transition-all duration-200 hover:-translate-y-1 hover:border-[var(--color-accent)] hover:shadow-[0_8px_24px_-6px_rgba(0,0,0,0.12)]"
      >
        {/* Icon chip */}
        <div
          class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-[var(--color-accent)]/15 text-[var(--color-accent-strong)] transition-colors duration-200 group-hover:bg-[var(--color-accent)]/25"
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            set:html={iconPaths[a.icon]}
          />
        </div>

        {/* Pain → answer */}
        <div>
          <div class="flex items-center gap-2 text-sm text-[var(--color-fg-muted)]">
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              class="text-red-500/70"
            >
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
            <span class="line-through decoration-1">{a.pain}</span>
          </div>
          <h3 class="mt-2 text-lg font-semibold text-[var(--color-fg)]">
            {a.answer}
          </h3>
        </div>

        {/* Detail */}
        <p class="text-sm leading-relaxed text-[var(--color-fg-muted)]">
          {a.detail}
        </p>
      </li>
    ))}
  </ul>
</section>
