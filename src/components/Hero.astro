---
/**
 * Hero — the killer above-the-fold.
 *
 * Strategy (from UX-CHARTER.md):
 *   - Lead with a frustration users instantly recognize (Zoom hides notes)
 *   - Pair it with a visual that PROVES the claim (sticky floating over Zoom)
 *   - Reduce friction with a single primary CTA (no "talk to sales", no signup)
 *   - Reinforce trust in the same viewport (3 chips: local, OSS, cross-platform)
 *
 * Implementation notes:
 *   - Pure CSS, zero JS (Astro static prerender). Bundle stays < 5 KB.
 *   - Both themes supported via CSS vars (light + dark).
 *   - Motion-safe: animations gated behind `motion-safe:` utilities.
 *   - The mockup is built from semantic divs (no images, so it's pixel-sharp
 *     on every retina display + scales perfectly + zero CLS).
 */
---

<section class="relative overflow-hidden">
  {/* Soft radial glow behind the hero — adds depth without an image */}
  <div
    class="pointer-events-none absolute inset-0 -z-10"
    aria-hidden="true"
  >
    <div
      class="absolute left-1/2 top-0 h-[600px] w-[1100px] -translate-x-1/2 rounded-full bg-[var(--color-accent)] opacity-[0.08] blur-[120px]"
    >
    </div>
  </div>

  <div
    class="mx-auto grid max-w-[1200px] gap-12 px-6 py-16 md:grid-cols-[1.1fr_1fr] md:gap-16 md:px-12 md:py-24 lg:py-28"
  >
    {/* LEFT — copy */}
    <div class="flex flex-col justify-center">
      <span
        class="inline-flex w-fit items-center gap-2 rounded-full border border-[var(--color-border)] bg-[var(--color-bg-subtle)] px-3 py-1 text-xs font-medium text-[var(--color-fg-muted)]"
      >
        <span class="relative inline-flex h-1.5 w-1.5">
          <span
            class="absolute inline-flex h-full w-full motion-safe:animate-ping rounded-full bg-[var(--color-accent)] opacity-75"
          ></span>
          <span
            class="relative inline-flex h-1.5 w-1.5 rounded-full bg-[var(--color-accent)]"
          ></span>
        </span>
        Free forever · No signup · 100% local
      </span>

      <h1
        class="mt-6 text-4xl font-bold leading-[1.05] tracking-tight text-[var(--color-fg)] sm:text-5xl md:text-[3.5rem] lg:text-[4rem]"
      >
        Sticky notes that
        <span class="relative inline-block whitespace-nowrap">
          <span class="relative z-10">actually float</span>
          <svg
            class="absolute -bottom-1 left-0 z-0 w-full"
            viewBox="0 0 300 12"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
            preserveAspectRatio="none"
          >
            <path
              d="M2 8C50 3 100 3 150 6C200 9 250 9 298 4"
              stroke="var(--color-accent)"
              stroke-width="8"
              stroke-linecap="round"
              opacity="0.85"
            ></path>
          </svg>
        </span>
        over Zoom.
      </h1>

      <p
        class="mt-6 max-w-xl text-lg leading-relaxed text-[var(--color-fg-muted)] md:text-xl"
      >
        Windows Sticky Notes hide behind every full-screen app. macOS Stickies
        don't work on Windows. Apple Notes uploads to iCloud. We fixed all three.
      </p>

      <div class="mt-9 flex flex-wrap items-center gap-3">
        <a
          href="/app"
          class="group inline-flex h-12 items-center gap-2 rounded-lg bg-[var(--color-fg)] px-6 text-base font-medium text-[var(--color-bg)] shadow-[0_1px_2px_rgba(0,0,0,0.05),0_4px_12px_rgba(0,0,0,0.08)] transition-all duration-150 hover:shadow-[0_2px_4px_rgba(0,0,0,0.08),0_8px_24px_rgba(0,0,0,0.12)] active:scale-[0.97] no-underline hover:no-underline"
        >
          Open notes — it's free
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.25"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            class="transition-transform duration-150 group-hover:translate-x-0.5"
          >
            <path d="M5 12h14M12 5l7 7-7 7"></path>
          </svg>
        </a>
        <a
          href="#why-switch"
          class="inline-flex h-12 items-center gap-2 rounded-lg border border-[var(--color-border)] bg-transparent px-6 text-base font-medium text-[var(--color-fg)] transition-colors duration-150 hover:bg-[var(--color-bg-muted)] active:scale-[0.97] no-underline hover:no-underline"
        >
          Why switch?
        </a>
      </div>

      {/* Trust chips — first one is highlighted as the killer claim */}
      <ul
        class="mt-9 flex flex-wrap items-center gap-x-4 gap-y-2.5 text-sm"
      >
        <li class="inline-flex items-center gap-1.5 rounded-full bg-[var(--color-accent)]/15 px-3 py-1.5 font-semibold text-[var(--color-fg)]">
          <svg
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.25"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
          0 KB ever uploaded
        </li>
        <li class="inline-flex items-center gap-1.5 text-[var(--color-fg-muted)]">
          <svg
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path
              d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"
            ></path>
          </svg>
          MIT open source
        </li>
        <li class="inline-flex items-center gap-1.5 text-[var(--color-fg-muted)]">
          <svg
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
            <line x1="8" y1="21" x2="16" y2="21"></line>
            <line x1="12" y1="17" x2="12" y2="21"></line>
          </svg>
          Mac · Win · Linux · ChromeOS
        </li>
      </ul>
    </div>

    {/* RIGHT — the killer visual: sticky note floating over a Zoom call */}
    <div class="relative flex items-center justify-center md:min-h-[480px]">
      <div
        class="relative w-full max-w-[480px] motion-safe:animate-[float_6s_ease-in-out_infinite]"
      >
        {/* Zoom call mockup — dimmed/blurred so the sticky note pops */}
        <div
          class="zoom-mock relative aspect-[4/3] overflow-hidden rounded-xl border border-[var(--color-border-strong)] bg-[#1a1a1f] shadow-[0_24px_48px_-12px_rgba(0,0,0,0.35)]"
          aria-hidden="true"
        >
          {/* Window chrome — Windows-style (NOT Mac dots — primary audience is Win users) */}
          <div
            class="flex items-center justify-between border-b border-white/5 bg-[#0d0d12] px-3 py-1.5"
          >
            <span class="text-[10px] font-medium tracking-wide text-white/40">
              Zoom Meeting · Q3 Strategy Review
            </span>
            <div class="flex items-center gap-3 text-white/40">
              <svg width="10" height="10" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true">
                <rect x="2" y="5.5" width="8" height="1"></rect>
              </svg>
              <svg width="10" height="10" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true">
                <rect x="2" y="2" width="8" height="8"></rect>
              </svg>
              <svg width="10" height="10" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M2 2l8 8M10 2L2 10"></path>
              </svg>
            </div>
          </div>

          {/* Video tile grid (2x2) */}
          <div class="grid h-[calc(100%-72px)] grid-cols-2 gap-1 p-1">
            <div class="zoom-tile relative overflow-hidden rounded bg-gradient-to-br from-[#3b3252] to-[#1f1a2e]">
              <div
                class="absolute bottom-1.5 left-1.5 rounded bg-black/50 px-1.5 py-0.5 text-[9px] text-white/80"
              >
                Sarah K.
              </div>
              <div
                class="absolute right-1.5 top-1.5 h-1.5 w-1.5 rounded-full bg-[#28ca42]"
              ></div>
            </div>
            <div class="zoom-tile relative overflow-hidden rounded bg-gradient-to-br from-[#1f3a4d] to-[#0f2238] ring-2 ring-[#28ca42]/60">
              <div
                class="absolute bottom-1.5 left-1.5 rounded bg-black/50 px-1.5 py-0.5 text-[9px] text-white/80"
              >
                Raj M. (speaking)
              </div>
            </div>
            <div class="zoom-tile relative overflow-hidden rounded bg-gradient-to-br from-[#3d2e2a] to-[#241915]">
              <div
                class="absolute bottom-1.5 left-1.5 rounded bg-black/50 px-1.5 py-0.5 text-[9px] text-white/80"
              >
                You
              </div>
            </div>
            <div class="zoom-tile relative overflow-hidden rounded bg-gradient-to-br from-[#1f3a2c] to-[#0f2218]">
              <div
                class="absolute bottom-1.5 left-1.5 rounded bg-black/50 px-1.5 py-0.5 text-[9px] text-white/80"
              >
                Priya S.
              </div>
            </div>
          </div>

          {/* Bottom toolbar */}
          <div
            class="absolute inset-x-0 bottom-0 flex items-center justify-center gap-2 border-t border-white/5 bg-[#0d0d12] py-2"
          >
            <span class="rounded bg-white/5 px-2 py-1 text-[9px] text-white/60">
              🎤 Mute
            </span>
            <span class="rounded bg-white/5 px-2 py-1 text-[9px] text-white/60">
              📹 Video
            </span>
            <span class="rounded bg-red-500/80 px-2 py-1 text-[9px] text-white">
              End
            </span>
          </div>
        </div>

        {/* THE STICKY NOTE — floating over the Zoom call, with strong ambient glow */}
        <div
          class="sticky-note pointer-events-auto absolute -right-2 top-12 w-[240px] -rotate-[3deg] rounded-md bg-[#fde047] p-4 shadow-[0_0_140px_-4px_rgba(253,224,71,0.85),0_0_80px_-8px_rgba(253,224,71,0.7),0_0_30px_-4px_rgba(253,224,71,0.5),0_2px_4px_rgba(0,0,0,0.08),0_12px_24px_-4px_rgba(0,0,0,0.18),0_24px_48px_-12px_rgba(0,0,0,0.4)] transition-transform duration-300 hover:rotate-0 hover:scale-[1.03] md:-right-6 md:top-16 md:w-[280px]"
          style="background-image: radial-gradient(rgba(0,0,0,0.04) 1px, transparent 1px); background-size: 16px 16px;"
        >
          {/* Tape strip at top */}
          <div
            class="absolute -top-2 left-1/2 h-4 w-16 -translate-x-1/2 -rotate-2 rounded-sm bg-white/60 backdrop-blur-sm"
            aria-hidden="true"
          ></div>

          <div
            class="text-[11px] font-semibold uppercase tracking-wider text-yellow-900/60"
          >
            Q3 Review · notes
          </div>
          <h3 class="mt-1 text-base font-bold text-yellow-950">
            Don't forget to ask
          </h3>

          <ul class="mt-3 space-y-1.5 text-[13px] text-yellow-950">
            <li class="flex items-start gap-2">
              <span
                class="mt-0.5 inline-block h-3 w-3 flex-shrink-0 rounded-sm border border-yellow-900/40"
              ></span>
              <span>Q4 budget approval</span>
            </li>
            <li class="flex items-start gap-2">
              <span
                class="mt-0.5 inline-block h-3 w-3 flex-shrink-0 rounded-sm border border-yellow-900/40"
              ></span>
              <span>Push back on Dec launch</span>
            </li>
            <li class="flex items-start gap-2 opacity-50 line-through">
              <span
                class="mt-0.5 inline-flex h-3 w-3 flex-shrink-0 items-center justify-center rounded-sm border border-yellow-900/60 bg-yellow-900/20"
              >
                <svg
                  width="8"
                  height="8"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="4"
                >
                  <path d="M5 12l5 5 9-13"></path>
                </svg>
              </span>
              <span>Headcount sign-off</span>
            </li>
            <li class="flex items-start gap-2">
              <span
                class="mt-0.5 inline-block h-3 w-3 flex-shrink-0 rounded-sm border border-yellow-900/40"
              ></span>
              <span>1:1 with Raj — Friday</span>
            </li>
          </ul>

          <p
            class="mt-3 border-t border-yellow-900/15 pt-2 text-[12px] italic text-yellow-900/70"
          >
            "They want answers, not data."
          </p>
        </div>

        {/* Floating "always on top" tag, animated */}
        <div
          class="absolute -left-2 top-4 inline-flex items-center gap-1.5 rounded-full border border-[var(--color-fg)]/15 bg-[var(--color-bg)] px-3 py-1.5 text-xs font-semibold text-[var(--color-fg)] shadow-[0_4px_12px_rgba(0,0,0,0.08),0_2px_4px_rgba(0,0,0,0.05)] motion-safe:animate-[pulse_2.5s_ease-in-out_infinite] md:-left-6"
        >
          <svg
            width="12"
            height="12"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M12 19V6M5 12l7-7 7 7"></path>
          </svg>
          Always on top
        </div>
      </div>
    </div>
  </div>

  <style is:global>
    /* Gentle float animation on the whole mockup — adds "alive" feel */
    @keyframes aotn-float {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-8px); }
    }
    @keyframes aotn-pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.85; }
    }
    .motion-safe\:animate-\[float_6s_ease-in-out_infinite\] {
      animation: aotn-float 6s ease-in-out infinite;
    }
    .motion-safe\:animate-\[pulse_2\.5s_ease-in-out_infinite\] {
      animation: aotn-pulse 2.5s ease-in-out infinite;
    }

    /* Subtle dimming on Zoom mockup to make sticky note pop */
    .zoom-mock {
      filter: brightness(0.85) saturate(0.85);
      transition: filter 300ms ease;
    }
    .zoom-mock:hover {
      filter: brightness(1) saturate(1);
    }
  </style>
</section>
