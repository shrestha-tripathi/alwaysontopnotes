---
/**
 * Top navigation. Sticky header with brand logo, primary links, theme toggle.
 * Mobile-responsive: hides secondary links under a hamburger on narrow screens.
 *
 * Brand logo is an inline SVG sticky note (yellow with slight rotation + corner fold tape).
 */
import { site } from "../site.config";
---

<header
  class="sticky top-0 z-40 border-b border-[var(--color-border)] bg-[var(--color-bg)]/80 backdrop-blur-md"
>
  <nav class="mx-auto flex h-16 max-w-[1200px] items-center justify-between px-6 md:px-12">
    {/* Brand */}
    <a
      href="/"
      class="group flex items-center gap-2.5 transition-opacity hover:opacity-80"
      aria-label={`${site.name} — home`}
    >
      <span class="inline-block transition-transform duration-200 group-hover:-rotate-6">
        <svg
          width="28"
          height="28"
          viewBox="0 0 32 32"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <rect
            x="4"
            y="6"
            width="24"
            height="24"
            rx="2"
            fill="var(--color-accent)"
            transform="rotate(-3 16 18)"
          />
          <rect
            x="4"
            y="6"
            width="24"
            height="3"
            fill="#eab308"
            transform="rotate(-3 16 18)"
          />
        </svg>
      </span>
      <span class="font-semibold tracking-tight text-[var(--color-fg)] text-[15px]">
        {site.name}
      </span>
    </a>

    {/* Primary links — hidden on mobile */}
    <div class="hidden items-center gap-1 md:flex">
      <a
        href="/how-it-works"
        class="rounded-md px-3 py-1.5 text-sm text-[var(--color-fg-muted)] transition-colors hover:bg-[var(--color-bg-muted)] hover:text-[var(--color-fg)] no-underline hover:no-underline"
        >How it works</a
      >
      <a
        href="/compare"
        class="rounded-md px-3 py-1.5 text-sm text-[var(--color-fg-muted)] transition-colors hover:bg-[var(--color-bg-muted)] hover:text-[var(--color-fg)] no-underline hover:no-underline"
        >Compare</a
      >
      <a
        href="/faq"
        class="rounded-md px-3 py-1.5 text-sm text-[var(--color-fg-muted)] transition-colors hover:bg-[var(--color-bg-muted)] hover:text-[var(--color-fg)] no-underline hover:no-underline"
        >FAQ</a
      >
    </div>

    {/* Right cluster */}
    <div class="flex items-center gap-2">
      {/* Theme toggle */}
      <button
        id="theme-toggle"
        type="button"
        aria-label="Toggle dark mode"
        title="Toggle theme"
        class="inline-flex h-9 w-9 items-center justify-center rounded-md text-[var(--color-fg-muted)] transition-colors hover:bg-[var(--color-bg-muted)] hover:text-[var(--color-fg)]"
      >
        {/* Sun icon (shown in dark mode) */}
        <svg
          id="theme-icon-sun"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          class="hidden"
        >
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
        </svg>
        {/* Moon icon (shown in light mode) */}
        <svg
          id="theme-icon-moon"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
      </button>

      {/* GitHub link */}
      <a
        href={site.githubRepo}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Source on GitHub"
        title="Open source on GitHub"
        class="inline-flex h-9 w-9 items-center justify-center rounded-md text-[var(--color-fg-muted)] transition-colors hover:bg-[var(--color-bg-muted)] hover:text-[var(--color-fg)]"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
          />
        </svg>
      </a>

      {/* Primary CTA */}
      <a
        href="/app"
        class="inline-flex h-9 items-center rounded-md bg-[var(--color-fg)] px-4 text-sm font-medium text-[var(--color-bg)] transition-opacity hover:opacity-90 no-underline hover:no-underline"
      >
        Open notes
      </a>
    </div>
  </nav>
</header>

<script>
  // Theme toggle wiring
  const btn = document.getElementById("theme-toggle");
  const iconSun = document.getElementById("theme-icon-sun");
  const iconMoon = document.getElementById("theme-icon-moon");

  function syncIcons() {
    const isDark = document.documentElement.getAttribute("data-theme") === "dark";
    iconSun?.classList.toggle("hidden", !isDark);
    iconMoon?.classList.toggle("hidden", isDark);
  }

  syncIcons();

  btn?.addEventListener("click", () => {
    const current = document.documentElement.getAttribute("data-theme");
    const next = current === "dark" ? "light" : "dark";
    document.documentElement.setAttribute("data-theme", next);
    try {
      localStorage.setItem("aotn:theme", next);
    } catch {
      /* private mode */
    }
    syncIcons();
  });
</script>
