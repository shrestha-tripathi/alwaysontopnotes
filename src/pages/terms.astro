---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { site } from "../site.config";

/**
 * /terms — Terms & Conditions. WebPage JSON-LD layered on the sitewide graph.
 * Governing law comes from site.jurisdiction. Standard indie-SaaS structure:
 * acceptance, service description, acceptable use, IP, disclaimer, liability
 * cap, governing law, changes, contact.
 */

const lastUpdated = "June 14, 2026";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: `Terms & Conditions — ${site.name}`,
  url: `${site.url}/terms`,
  description: `The terms governing your use of ${site.name}.`,
  dateModified: "2026-06-14",
  publisher: { "@id": `${site.url}/#organization` },
};
---

<Layout
  title="Terms & Conditions"
  description="The terms governing your use of AlwaysOnTopNotes — a free, open-source, client-side notes app provided as-is. Acceptable use, disclaimers, and governing law."
  jsonLd={[jsonLd]}
>
  <Nav />

  <main class="mx-auto max-w-[760px] px-6 py-16 md:px-8 md:py-24">
    <header>
      <h1 class="text-4xl font-bold tracking-tight text-[var(--color-fg)] md:text-5xl">
        Terms &amp; Conditions
      </h1>
      <p class="mt-4 text-sm text-[var(--color-fg-subtle)]">Last updated: {lastUpdated}</p>
      <p class="mt-6 rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-subtle)] p-5 text-base leading-relaxed text-[var(--color-fg-muted)]">
        <strong class="font-semibold text-[var(--color-fg)]">In plain terms:</strong>
        {site.name} is a free tool provided as-is. Your notes are yours and stay
        on your device. Don't misuse the service, and understand we can't be
        liable for a free, client-side app. The full terms are below.
      </p>
    </header>

    <div class="prose mt-12 max-w-none space-y-10">
      <section>
        <h2 class="text-2xl font-bold tracking-tight text-[var(--color-fg)]">1. Acceptance of terms</h2>
        <p class="mt-3 text-base leading-relaxed text-[var(--color-fg-muted)]">
          By accessing or using {site.name} (the “Service”) at {site.domain},
          you agree to be bound by these Terms &amp; Conditions and our
          <a href="/privacy-policy" class="prose-link">Privacy Policy</a>. If you
          do not agree, please do not use the Service.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-bold tracking-tight text-[var(--color-fg)]">2. What the Service is</h2>
        <p class="mt-3 text-base leading-relaxed text-[var(--color-fg-muted)]">
          {site.name} is a free, client-side web application for creating sticky
          notes that can float in an always-on-top window. All notes are stored
          locally in your browser on your device. We do not host, store, or have
          access to your note content, and we provide no account, server-side
          sync, or backup of your notes.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-bold tracking-tight text-[var(--color-fg)]">3. Your content and your responsibility</h2>
        <p class="mt-3 text-base leading-relaxed text-[var(--color-fg-muted)]">
          You retain all rights to the notes you create. Because your notes live
          only on your device, <strong class="font-semibold text-[var(--color-fg)]">you are
          solely responsible for backing them up</strong> (the app provides a
          one-click Markdown export for this purpose). Clearing your browser data,
          uninstalling your browser, or device loss will delete your notes, and we
          cannot recover them.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-bold tracking-tight text-[var(--color-fg)]">4. Acceptable use</h2>
        <p class="mt-3 text-base leading-relaxed text-[var(--color-fg-muted)]">You agree not to:</p>
        <ul class="mt-4 list-disc space-y-2 pl-6 text-base leading-relaxed text-[var(--color-fg-muted)]">
          <li>use the Service for any unlawful purpose or in violation of any applicable law;</li>
          <li>attempt to disrupt, attack, or gain unauthorized access to the Service or its infrastructure;</li>
          <li>misrepresent the Service as your own, or remove copyright/license notices from the source;</li>
          <li>use automated means to abuse the Service in a way that degrades it for others.</li>
        </ul>
      </section>

      <section>
        <h2 class="text-2xl font-bold tracking-tight text-[var(--color-fg)]">5. Open-source license</h2>
        <p class="mt-3 text-base leading-relaxed text-[var(--color-fg-muted)]">
          The {site.name} source code is released under the MIT License and is
          available on
          <a href={site.githubRepo} target="_blank" rel="noopener" class="prose-link">GitHub</a>.
          Your use of the source code is governed by that license. These Terms
          govern your use of the hosted Service at {site.domain}.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-bold tracking-tight text-[var(--color-fg)]">6. Disclaimer of warranties</h2>
        <p class="mt-3 text-base leading-relaxed text-[var(--color-fg-muted)]">
          The Service is provided <strong class="font-semibold text-[var(--color-fg)]">“as is”
          and “as available”</strong>, without warranties of any kind, whether
          express or implied, including but not limited to merchantability,
          fitness for a particular purpose, and non-infringement. We do not
          warrant that the Service will be uninterrupted, error-free, or that any
          data stored in your browser will be preserved.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-bold tracking-tight text-[var(--color-fg)]">7. Limitation of liability</h2>
        <p class="mt-3 text-base leading-relaxed text-[var(--color-fg-muted)]">
          To the maximum extent permitted by law, {site.author} and {site.name}
          shall not be liable for any indirect, incidental, special,
          consequential, or punitive damages, or any loss of data (including lost
          notes), arising from your use of or inability to use the Service. As the
          Service is provided free of charge, our total aggregate liability shall
          not exceed zero.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-bold tracking-tight text-[var(--color-fg)]">8. Advertising</h2>
        <p class="mt-3 text-base leading-relaxed text-[var(--color-fg-muted)]">
          The Service may display third-party advertising (e.g. Google AdSense) to
          support its free operation. Your interactions with advertisers are
          solely between you and the advertiser; we are not responsible for
          third-party ads or linked content. See our
          <a href="/privacy-policy" class="prose-link">Privacy Policy</a> for how
          advertising cookies are handled.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-bold tracking-tight text-[var(--color-fg)]">9. Changes to the Service and terms</h2>
        <p class="mt-3 text-base leading-relaxed text-[var(--color-fg-muted)]">
          We may modify or discontinue the Service, or update these Terms, at any
          time. Material changes will be reflected by the “Last updated” date
          above. Continued use after changes constitutes acceptance.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-bold tracking-tight text-[var(--color-fg)]">10. Governing law</h2>
        <p class="mt-3 text-base leading-relaxed text-[var(--color-fg-muted)]">
          These Terms are governed by the laws of {site.jurisdiction}, without
          regard to its conflict-of-laws principles. Any disputes shall be subject
          to the exclusive jurisdiction of the courts located in {site.jurisdiction}.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-bold tracking-tight text-[var(--color-fg)]">11. Contact</h2>
        <p class="mt-3 text-base leading-relaxed text-[var(--color-fg-muted)]">
          Questions about these Terms? Email
          <a href={`mailto:${site.contactEmail}`} class="prose-link">{site.contactEmail}</a>.
        </p>
      </section>
    </div>
  </main>

  <Footer />
</Layout>
