---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { site } from "../site.config";
---

<Layout>
  <Nav />

  <main class="mx-auto max-w-[1200px] px-6 md:px-12">
    {/* Hero — minimal placeholder for Commit 1. Real hero ships in Commit 2. */}
    <section class="py-24 md:py-32">
      <div class="max-w-3xl">
        <span
          class="inline-flex items-center gap-2 rounded-full border border-[var(--color-border)] bg-[var(--color-bg-subtle)] px-3 py-1 text-xs font-medium text-[var(--color-fg-muted)]"
        >
          <span class="inline-block h-1.5 w-1.5 rounded-full bg-[var(--color-accent)]"></span>
          Now in private beta
        </span>

        <h1
          class="mt-6 text-4xl font-bold tracking-tight text-[var(--color-fg)] md:text-6xl lg:text-7xl"
        >
          Sticky notes that
          <span class="relative inline-block">
            <span class="relative z-10">actually float</span>
            <span
              class="absolute inset-x-0 bottom-1 h-3 -skew-y-1 bg-[var(--color-accent)] opacity-80"
              aria-hidden="true"
            ></span>
          </span>
          over Zoom.
        </h1>

        <p
          class="mt-6 max-w-2xl text-lg leading-relaxed text-[var(--color-fg-muted)] md:text-xl"
        >
          {site.tagline} A real OS-level floating window. Works on Mac, Windows,
          Linux, Chromebook. No install. No signup. Notes never leave your
          device.
        </p>

        <div class="mt-10 flex flex-wrap items-center gap-4">
          <a
            href="/app"
            class="inline-flex h-12 items-center gap-2 rounded-lg bg-[var(--color-fg)] px-6 text-base font-medium text-[var(--color-bg)] transition-opacity hover:opacity-90 no-underline hover:no-underline"
          >
            Open notes
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </a>
          <a
            href="/how-it-works"
            class="inline-flex h-12 items-center rounded-lg border border-[var(--color-border)] bg-transparent px-6 text-base font-medium text-[var(--color-fg)] transition-colors hover:bg-[var(--color-bg-muted)] no-underline hover:no-underline"
          >
            See how it works
          </a>
        </div>

        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-[var(--color-fg-subtle)]">
          <span class="inline-flex items-center gap-1.5">
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
            </svg>
            100% local
          </span>
          <span class="inline-flex items-center gap-1.5">
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M9 11l3 3L22 4" />
              <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" />
            </svg>
            MIT open source
          </span>
          <span class="inline-flex items-center gap-1.5">
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="10" />
              <line x1="2" y1="12" x2="22" y2="12" />
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
            </svg>
            Works on any desktop browser
          </span>
        </div>
      </div>
    </section>

    {/* TODO Commit 2-5: hero visual, why-switch, comparison, mechanism, FAQ */}
    <section class="py-12">
      <div
        class="rounded-xl border border-dashed border-[var(--color-border)] bg-[var(--color-bg-subtle)] p-8 text-center"
      >
        <p class="text-sm text-[var(--color-fg-muted)]">
          More sections shipping over the next few commits — hero animation,
          comparison vs Windows Sticky Notes &amp; macOS Stickies, mechanism
          explainer, FAQ.
        </p>
        <p class="mt-2 text-xs text-[var(--color-fg-subtle)]">
          Building in public →{" "}
          <a
            href={site.githubRepo}
            class="prose-link text-[var(--color-fg-muted)] hover:text-[var(--color-fg)]"
            target="_blank"
            rel="noopener"
          >{site.githubRepo.replace("https://github.com/", "")}</a>
        </p>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
