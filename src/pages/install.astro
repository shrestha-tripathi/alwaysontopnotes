---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { site } from "../site.config";

/**
 * /install — how to install AlwaysOnTopNotes as a PWA (desktop + mobile) and
 * what offline support you get. WebPage JSON-LD layered on the sitewide graph.
 */

const desktopSteps = [
  "Open the app in Chrome, Edge, Brave, or Opera on your computer.",
  "Look for the install icon (a small monitor with a down-arrow) at the right edge of the address bar — or open the browser menu and choose “Install AlwaysOnTopNotes”.",
  "Click Install. The app gets its own icon in your Start menu / Dock / Applications and opens in its own window, no browser tabs around it.",
];

const iosSteps = [
  "Open the app in Safari on your iPhone or iPad.",
  "Tap the Share button (the square with an up-arrow).",
  "Scroll down and tap “Add to Home Screen”, then Add.",
];

const androidSteps = [
  "Open the app in Chrome on your Android device.",
  "Tap the ⋮ menu in the top-right.",
  "Tap “Install app” or “Add to Home screen”, then confirm.",
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: `Install ${site.name}`,
  url: `${site.url}/install`,
  description: `Install ${site.name} as an app on desktop, iOS, or Android — with full offline support.`,
  publisher: { "@id": `${site.url}/#organization` },
};

const renderSteps = (steps: string[]) =>
  steps.map((s, i) => ({ n: i + 1, text: s }));
---

<Layout
  title="Install the app"
  description="Install AlwaysOnTopNotes as a Progressive Web App on desktop (Chrome/Edge), iOS, or Android — get a home-screen icon and full offline support. No app store needed."
  jsonLd={[jsonLd]}
>
  <Nav />

  <main class="mx-auto max-w-[760px] px-6 py-16 md:px-8 md:py-24">
    <header class="max-w-2xl">
      <span class="text-xs font-semibold uppercase tracking-wider text-[var(--color-accent-strong)]">
        Install
      </span>
      <h1 class="mt-3 text-4xl font-bold tracking-tight text-[var(--color-fg)] md:text-5xl">
        Install it like a real app.
      </h1>
      <p class="mt-5 text-lg leading-relaxed text-[var(--color-fg-muted)]">
        {site.name} is a Progressive Web App. Install it for a home-screen or
        dock icon, its own window, and full offline support — no app store, no
        download, about five seconds.
      </p>
    </header>

    {/* Desktop */}
    <section class="mt-14">
      <h2 class="text-2xl font-bold tracking-tight text-[var(--color-fg)]">On desktop (Chrome, Edge, Brave, Opera)</h2>
      <p class="mt-2 text-sm text-[var(--color-fg-subtle)]">
        This is the recommended setup — desktop is where the floating
        always-on-top window works.
      </p>
      <ol class="mt-6 space-y-3">
        {renderSteps(desktopSteps).map((s) => (
          <li class="flex gap-4 rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-subtle)] p-5">
            <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-[var(--color-accent)]/15 text-sm font-semibold text-[var(--color-accent-strong)]">
              {s.n}
            </span>
            <p class="text-sm leading-relaxed text-[var(--color-fg-muted)]">{s.text}</p>
          </li>
        ))}
      </ol>
    </section>

    {/* Mobile */}
    <section class="mt-14 grid gap-6 md:grid-cols-2">
      <div>
        <h2 class="text-xl font-bold tracking-tight text-[var(--color-fg)]">On iPhone &amp; iPad</h2>
        <ol class="mt-5 space-y-3">
          {renderSteps(iosSteps).map((s) => (
            <li class="flex gap-3 text-sm leading-relaxed text-[var(--color-fg-muted)]">
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[var(--color-accent)]/15 text-xs font-semibold text-[var(--color-accent-strong)]">{s.n}</span>
              <span>{s.text}</span>
            </li>
          ))}
        </ol>
      </div>
      <div>
        <h2 class="text-xl font-bold tracking-tight text-[var(--color-fg)]">On Android</h2>
        <ol class="mt-5 space-y-3">
          {renderSteps(androidSteps).map((s) => (
            <li class="flex gap-3 text-sm leading-relaxed text-[var(--color-fg-muted)]">
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[var(--color-accent)]/15 text-xs font-semibold text-[var(--color-accent-strong)]">{s.n}</span>
              <span>{s.text}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {/* Offline note */}
    <section class="mt-14 rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-muted)] p-8">
      <h2 class="text-xl font-bold tracking-tight text-[var(--color-fg)]">Works fully offline</h2>
      <p class="mt-3 text-base leading-relaxed text-[var(--color-fg-muted)]">
        Once you've opened {site.name} a single time, it's cached on your device.
        After that it works with no internet at all — create, edit, search, color,
        and pop out notes on a plane or a dead-wifi cafe. Your notes never needed
        the network to begin with, because they live locally in your browser.
      </p>
    </section>

    {/* Note on mobile floating */}
    <p class="mt-8 text-sm leading-relaxed text-[var(--color-fg-subtle)]">
      A note on phones: installing works everywhere, but the always-on-top
      <em>floating window</em> is a desktop-only browser feature today. On mobile
      you get the full note-taking app; the floating pop-out appears on desktop.
      See <a href="/how-it-works" class="prose-link">how it works</a> for details.
    </p>

    <div class="mt-10">
      <a
        href="/app"
        class="inline-flex h-11 items-center rounded-lg bg-[var(--color-fg)] px-5 text-sm font-medium text-[var(--color-bg)] transition-opacity hover:opacity-90 no-underline hover:no-underline"
      >
        Open the app to install
      </a>
    </div>
  </main>

  <Footer />
</Layout>
