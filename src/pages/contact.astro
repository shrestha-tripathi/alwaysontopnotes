---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { site } from "../site.config";

/**
 * /contact — no-form contact (static site = no backend to process a form).
 * Clean copyable channels as cards: email, GitHub issues, security disclosures.
 * ContactPage JSON-LD layered on the sitewide graph.
 */

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: `Contact ${site.name}`,
  url: `${site.url}/contact`,
  description: `Get in touch with ${site.name} — email, GitHub issues, or security disclosures.`,
  publisher: { "@id": `${site.url}/#organization` },
};

const channels = [
  {
    icon: "mail",
    title: "Email",
    desc: "General questions, feedback, feature ideas, or data requests. We usually reply within 2–3 days.",
    value: site.contactEmail,
    href: `mailto:${site.contactEmail}`,
  },
  {
    icon: "github",
    title: "GitHub Issues",
    desc: "Found a bug or want to request a feature? File it in the open — it's the fastest way to get it tracked.",
    value: "Open an issue",
    href: `${site.githubRepo}/issues`,
    external: true,
  },
  {
    icon: "shield",
    title: "Security disclosures",
    desc: "Found a vulnerability? Email us with the subject prefix [Security] and we'll prioritize it.",
    value: site.contactEmail,
    href: `mailto:${site.contactEmail}?subject=%5BSecurity%5D`,
  },
];

const icons: Record<string, string> = {
  mail: `<rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>`,
  github: `<path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>`,
  shield: `<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>`,
};
---

<Layout
  title="Contact"
  description="Get in touch with AlwaysOnTopNotes — email for questions and data requests, GitHub for bugs and feature requests, or report a security issue."
  jsonLd={[jsonLd]}
>
  <Nav />

  <main class="mx-auto max-w-[700px] px-6 py-16 md:px-8 md:py-24">
    <header class="max-w-2xl">
      <span class="text-xs font-semibold uppercase tracking-wider text-[var(--color-accent-strong)]">
        Contact
      </span>
      <h1 class="mt-3 text-4xl font-bold tracking-tight text-[var(--color-fg)] md:text-5xl">
        Get in touch.
      </h1>
      <p class="mt-5 text-lg leading-relaxed text-[var(--color-fg-muted)]">
        Questions, feedback, bug reports, or a privacy request — here's how to
        reach us. We're a small independent project and we read everything.
      </p>
    </header>

    <div class="mt-12 space-y-4">
      {channels.map((c) => (
        <a
          href={c.href}
          target={c.external ? "_blank" : undefined}
          rel={c.external ? "noopener" : undefined}
          class="group flex items-start gap-5 rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-subtle)] p-6 transition-all hover:-translate-y-0.5 hover:border-[var(--color-accent)] no-underline hover:no-underline"
        >
          <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-[var(--color-accent)]/15 text-[var(--color-accent-strong)]">
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.85"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              set:html={icons[c.icon]}
            />
          </div>
          <div class="min-w-0">
            <h2 class="text-base font-semibold text-[var(--color-fg)]">{c.title}</h2>
            <p class="mt-1 text-sm leading-relaxed text-[var(--color-fg-muted)]">{c.desc}</p>
            <p class="mt-2 text-sm font-medium text-[var(--color-accent-strong)] group-hover:underline">
              {c.value} →
            </p>
          </div>
        </a>
      ))}
    </div>

    <p class="mt-10 text-sm leading-relaxed text-[var(--color-fg-subtle)]">
      Looking for how your data is handled? Read our
      <a href="/privacy-policy" class="prose-link">Privacy Policy</a>. Want to
      know how the floating window works? See
      <a href="/how-it-works" class="prose-link">How it works</a>.
    </p>
  </main>

  <Footer />
</Layout>
