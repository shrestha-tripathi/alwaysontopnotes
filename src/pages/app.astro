---
/**
 * /app — the AlwaysOnTopNotes notes app.
 *
 * Phase 2 · Commit 6: two-pane shell + in-memory CRUD.
 * - Left: searchable list of sticky-note cards (create / select / delete).
 * - Right: editor pane (plain <textarea> for now; Tiptap lands in commit 8).
 * - State lives in `notesStore`, persisted through a StorageAdapter. Commit 6
 *   uses the in-memory adapter, so notes are lost on reload — that's expected
 *   until commit 7 wires IndexedDB. Everything else is final.
 *
 * Single-island pattern (mirrors FTN's transfer.astro): one <script> below
 * owns all interactivity; the markup here is just the static shell it hydrates.
 */
import Layout from "../layouts/Layout.astro";
import { site } from "../site.config";
---

<Layout
  title="Notes"
  description="Your private sticky notes. Nothing uploads — notes live on your device."
  noindex={true}
>
  <div id="app-root" class="flex h-[100dvh] flex-col overflow-hidden">
    {/* Slim top bar — brand home link + status, keeps the app chrome minimal */}
    <header
      class="flex h-12 shrink-0 items-center justify-between border-b border-[var(--color-border)] bg-[var(--color-bg)] px-3"
    >
      <a
        href="/"
        class="flex items-center gap-2 text-[var(--color-fg)] no-underline hover:no-underline hover:opacity-80"
        aria-label={`${site.name} — home`}
      >
        <svg width="20" height="20" viewBox="0 0 32 32" fill="none" aria-hidden="true">
          <rect x="4" y="6" width="24" height="24" rx="2" fill="var(--color-accent)" transform="rotate(-3 16 18)"></rect>
          <rect x="4" y="6" width="24" height="3" fill="#eab308" transform="rotate(-3 16 18)"></rect>
        </svg>
        <span class="text-sm font-semibold tracking-tight">{site.name}</span>
      </a>

      <div class="flex items-center gap-3">
        {/* Save status — wired in commit 8; placeholder reserved now */}
        <span
          id="save-status"
          class="text-xs text-[var(--color-fg-subtle)] tabular-nums"
          aria-live="polite"
        ></span>
        <span class="hidden text-xs text-[var(--color-fg-subtle)] sm:inline">
          🔒 On your device
        </span>
      </div>
    </header>

    {/* Two-pane body */}
    <div class="flex min-h-0 flex-1">
      {/* ── Sidebar ─────────────────────────────────────────── */}
      <aside
        class="flex w-full max-w-[320px] shrink-0 flex-col border-r border-[var(--color-border)] bg-[var(--color-bg-subtle)] md:w-[300px]"
        aria-label="Notes list"
      >
        {/* Search + new */}
        <div class="flex items-center gap-2 border-b border-[var(--color-border)] p-2.5">
          <div class="relative flex-1">
            <svg
              class="pointer-events-none absolute left-2.5 top-1/2 -translate-y-1/2 text-[var(--color-fg-subtle)]"
              width="15" height="15" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"
            >
              <circle cx="11" cy="11" r="7"></circle>
              <path d="m21 21-4.3-4.3"></path>
            </svg>
            <input
              id="search-input"
              type="text"
              placeholder="Search notes…"
              autocomplete="off"
              spellcheck="false"
              aria-label="Search notes"
              class="h-9 w-full rounded-md border border-[var(--color-border)] bg-[var(--color-bg)] pl-8 pr-3 text-sm text-[var(--color-fg)] placeholder:text-[var(--color-fg-subtle)] focus:border-[var(--color-accent)] focus:outline-none"
            />
          </div>
          <button
            id="new-note-btn"
            type="button"
            title="New note (N)"
            aria-label="New note"
            class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-md bg-[var(--color-fg)] text-[var(--color-bg)] transition-opacity hover:opacity-90 active:scale-95"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <path d="M12 5v14M5 12h14"></path>
            </svg>
          </button>
        </div>

        {/* Note list (populated by the island) */}
        <ul
          id="note-list"
          class="flex min-h-0 flex-1 flex-col gap-2 overflow-y-auto p-2.5"
          role="listbox"
          aria-label="Your notes"
        ></ul>

        {/* Empty state (toggled by the island) */}
        <div
          id="list-empty"
          class="hidden flex-1 flex-col items-center justify-center gap-3 p-6 text-center"
        >
          <div class="text-3xl">🗒️</div>
          <p class="text-sm text-[var(--color-fg-muted)]">
            Your fridge is empty.<br />Press <kbd class="rounded border border-[var(--color-border)] bg-[var(--color-bg-muted)] px-1.5 py-0.5 text-xs font-medium">N</kbd> to start.
          </p>
        </div>

        {/* No-results state (toggled by the island when a search matches nothing) */}
        <div
          id="list-no-results"
          class="hidden flex-1 flex-col items-center justify-center gap-3 p-6 text-center"
        >
          <div class="text-3xl">🔍</div>
          <p class="text-sm text-[var(--color-fg-muted)]">
            No notes match “<span id="no-results-query" class="font-semibold text-[var(--color-fg)]"></span>”.
          </p>
        </div>
      </aside>

      {/* ── Editor pane ─────────────────────────────────────── */}
      <main class="relative flex min-w-0 flex-1 flex-col bg-[var(--color-bg)]">
        {/* Editor toolbar (color + pin + delete) — shown only with a selection */}
        <div
          id="editor-toolbar"
          class="hidden h-12 shrink-0 items-center justify-between border-b border-[var(--color-border)] px-3"
        >
          <div class="flex items-center gap-1.5">
            <button
              id="color-btn"
              type="button"
              title="Note color"
              aria-label="Note color"
              aria-haspopup="true"
              aria-expanded="false"
              class="inline-flex h-8 w-8 items-center justify-center rounded-md text-[var(--color-fg-muted)] transition-colors hover:bg-[var(--color-bg-muted)] hover:text-[var(--color-fg)]"
            >
              <span
                id="color-btn-dot"
                class="h-4 w-4 rounded-full border border-black/15 shadow-sm"
                style="background:#fde047"
                aria-hidden="true"
              ></span>
            </button>
            <button
              id="pin-btn"
              type="button"
              title="Pin note"
              aria-label="Pin note"
              class="inline-flex h-8 w-8 items-center justify-center rounded-md text-[var(--color-fg-muted)] transition-colors hover:bg-[var(--color-bg-muted)] hover:text-[var(--color-fg)]"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 17v5M9 10.76a2 2 0 0 1-1.11 1.79l-1.78.9A2 2 0 0 0 5 15.24V16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-.76a2 2 0 0 0-1.11-1.79l-1.78-.9A2 2 0 0 1 15 10.76V7a1 1 0 0 1 1-1 2 2 0 0 0 0-4H8a2 2 0 0 0 0 4 1 1 0 0 1 1 1z"></path>
              </svg>
            </button>
          </div>
          <button
            id="delete-btn"
            type="button"
            title="Delete note"
            aria-label="Delete note"
            class="inline-flex h-8 w-8 items-center justify-center rounded-md text-[var(--color-fg-muted)] transition-colors hover:bg-[color-mix(in_srgb,var(--color-danger)_14%,transparent)] hover:text-[var(--color-danger)]"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M10 11v6M14 11v6"></path>
            </svg>
          </button>
        </div>

        {/* Color-picker popover (8 semantic swatches — UX-CHARTER §3). Anchored
            under the color button; toggled open via #color-btn. Built once here,
            populated + wired in the island. */}
        <div
          id="color-popover"
          class="absolute left-3 top-12 z-40 hidden w-[180px] rounded-xl border border-[var(--color-border)] bg-[var(--color-bg)] p-2 shadow-xl"
          role="menu"
          aria-label="Note color"
        >
          <div id="color-grid" class="grid grid-cols-4 gap-1.5"></div>
        </div>

        {/* The editor surface */}
        <div class="min-h-0 flex-1 overflow-y-auto">
          {/* Tiptap mounts its .ProseMirror into this host on first select. */}
          <div
            id="editor-host"
            class="hidden h-full px-6 py-5"
          ></div>

          {/* No-selection state */}
          <div
            id="editor-empty"
            class="flex h-full flex-col items-center justify-center gap-3 p-6 text-center"
          >
            <div class="text-4xl">📝</div>
            <p class="max-w-xs text-sm text-[var(--color-fg-muted)]">
              Select a note, or press
              <kbd class="rounded border border-[var(--color-border)] bg-[var(--color-bg-muted)] px-1.5 py-0.5 text-xs font-medium">N</kbd>
              to create one.
            </p>
          </div>
        </div>
      </main>
    </div>

    {/* Floating selection toolbar (Tiptap BubbleMenu host). Hidden until a
        text selection exists; positioned by @floating-ui via the extension. */}
    <div
      id="bubble-menu"
      class="flex items-center gap-0.5 rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-subtle)] p-1 shadow-lg"
      role="toolbar"
      aria-label="Text formatting"
    >
      <button type="button" data-cmd="bold" title="Bold (Ctrl/Cmd+B)" aria-label="Bold" class="bubble-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 4h8a4 4 0 0 1 0 8H6zM6 12h9a4 4 0 0 1 0 8H6z"></path></svg>
      </button>
      <button type="button" data-cmd="italic" title="Italic (Ctrl/Cmd+I)" aria-label="Italic" class="bubble-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 4h-9M14 20H5M15 4 9 20"></path></svg>
      </button>
      <button type="button" data-cmd="strike" title="Strikethrough" aria-label="Strikethrough" class="bubble-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 4H9a3 3 0 0 0-2.83 4M14 12a4 4 0 0 1 0 8H6M4 12h16"></path></svg>
      </button>
      <button type="button" data-cmd="code" title="Inline code" aria-label="Inline code" class="bubble-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m16 18 6-6-6-6M8 6l-6 6 6 6"></path></svg>
      </button>
      <span class="mx-0.5 h-5 w-px bg-[var(--color-border)]" aria-hidden="true"></span>
      <button type="button" data-cmd="link" title="Add/edit link (Ctrl/Cmd+K)" aria-label="Add link" class="bubble-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
      </button>
      {/* Text color — 5 quick swatches + clear */}
      <span class="mx-0.5 h-5 w-px bg-[var(--color-border)]" aria-hidden="true"></span>
      <div class="flex items-center gap-0.5" role="group" aria-label="Text color">
        <button type="button" data-color="#ef4444" title="Red text" aria-label="Red text" class="bubble-swatch" style="background:#ef4444"></button>
        <button type="button" data-color="#f59e0b" title="Amber text" aria-label="Amber text" class="bubble-swatch" style="background:#f59e0b"></button>
        <button type="button" data-color="#22c55e" title="Green text" aria-label="Green text" class="bubble-swatch" style="background:#22c55e"></button>
        <button type="button" data-color="#3b82f6" title="Blue text" aria-label="Blue text" class="bubble-swatch" style="background:#3b82f6"></button>
        <button type="button" data-color="" title="Default color" aria-label="Clear color" class="bubble-btn text-[11px] font-semibold">A</button>
      </div>
    </div>

    {/* Undo-delete toast (single, replaces — never stacks) */}
    <div
      id="toast"
      class="pointer-events-none fixed bottom-4 left-1/2 z-50 hidden -translate-x-1/2"
      role="status"
      aria-live="polite"
    >
      <div class="pointer-events-auto flex items-center gap-3 rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-subtle)] px-4 py-2.5 shadow-lg">
        <span id="toast-msg" class="text-sm text-[var(--color-fg)]"></span>
        <button
          id="toast-action"
          type="button"
          class="text-sm font-semibold text-[var(--color-accent-strong)] hover:underline"
        ></button>
      </div>
    </div>
  </div>

  <script>
    import { notesStore } from "../lib/notesStore";
    import { searchNotes } from "../lib/searchNotes";
    import { swatchOf, rotationFor, SWATCHES, COLOR_ORDER } from "../lib/colors";
    import { pickStorage } from "../lib/storage";
    import type { StickyColor } from "../lib/types";
    import type { Editor } from "@tiptap/core";
    import type { JSONContent } from "../lib/types";

    // ── element handles ───────────────────────────────────────────────
    const $ = <T extends HTMLElement = HTMLElement>(id: string): T =>
      document.getElementById(id) as T;

    const listEl = $<HTMLUListElement>("note-list");
    const listEmptyEl = $("list-empty");
    const listNoResultsEl = $("list-no-results");
    const noResultsQueryEl = $("no-results-query");
    const searchEl = $<HTMLInputElement>("search-input");
    const newBtn = $<HTMLButtonElement>("new-note-btn");
    const editorHost = $("editor-host");
    const editorEmptyEl = $("editor-empty");
    const toolbarEl = $("editor-toolbar");
    const pinBtn = $<HTMLButtonElement>("pin-btn");
    const colorBtn = $<HTMLButtonElement>("color-btn");
    const colorBtnDot = $("color-btn-dot");
    const colorPopover = $("color-popover");
    const colorGrid = $("color-grid");
    const deleteBtn = $<HTMLButtonElement>("delete-btn");
    const bubbleEl = $("bubble-menu");
    const toastEl = $("toast");
    const toastMsg = $("toast-msg");
    const toastAction = $<HTMLButtonElement>("toast-action");

    // ── Tiptap editor (lazy — created on first note select) ───────────
    let editor: Editor | null = null;
    let editorNoteId: string | null = null;   // which note the editor currently holds
    let applyingProgrammatic = false;          // guard: ignore onUpdate during setContent
    let saveDebounce: ReturnType<typeof setTimeout> | null = null;
    let savedFlashTimer: ReturnType<typeof setTimeout> | null = null;

    async function ensureEditor(): Promise<Editor> {
      if (editor) return editor;
      // Lazy-load Tiptap so the sidebar paints before the editor chunk arrives.
      const { makeEditor } = await import("../lib/tiptapSetup");
      editor = makeEditor({
        element: editorHost,
        content: { type: "doc", content: [{ type: "paragraph" }] },
        bubbleElement: bubbleEl,
        onUpdate: (doc: JSONContent) => {
          if (applyingProgrammatic) return; // setContent shouldn't trigger a save
          scheduleSave(doc);
        },
      });
      wireBubbleToolbar(editor);
      return editor;
    }

    /** Load a note's doc into the editor (create editor on first use).
     *  `force` reloads even if the same note is already shown — used when a
     *  sibling tab edited the active note and we want to reflect it. */
    async function loadNoteIntoEditor(
      noteId: string,
      doc: JSONContent,
      force = false,
    ): Promise<void> {
      const ed = await ensureEditor();
      if (editorNoteId === noteId && !force) return; // already showing this note
      editorNoteId = noteId;
      applyingProgrammatic = true;
      // `false` = don't emit an update transaction for this programmatic set.
      ed.commands.setContent(doc as Record<string, unknown>, { emitUpdate: false });
      applyingProgrammatic = false;
    }

    /** 500ms debounced autosave → store.updateActiveDoc. A non-null
     *  `saveDebounce` means an edit is pending (the user is actively typing);
     *  we null it after the save fires so remote-sync can tell idle from busy. */
    function scheduleSave(doc: JSONContent): void {
      setSaveStatus("saving");
      if (saveDebounce) clearTimeout(saveDebounce);
      saveDebounce = setTimeout(() => {
        saveDebounce = null;
        void notesStore.updateActiveDoc(doc);
      }, 500);
    }

    // ── save status indicator ("Saving…" → "Saved ✓") ────────────────
    type SaveStatus = "idle" | "saving" | "saved";
    function setSaveStatus(s: SaveStatus): void {
      const el = $("save-status");
      if (savedFlashTimer) { clearTimeout(savedFlashTimer); savedFlashTimer = null; }
      if (s === "saving") {
        el.textContent = "Saving…";
        el.style.color = "var(--color-fg-subtle)";
      } else if (s === "saved") {
        el.textContent = "Saved ✓";
        el.style.color = "var(--color-success)";
        // Fade back to idle after a moment.
        savedFlashTimer = setTimeout(() => { el.textContent = ""; }, 1600);
      } else {
        el.textContent = "";
      }
    }

    // ── bubble toolbar wiring ──────────────────────────────────────────
    function wireBubbleToolbar(ed: Editor): void {
      bubbleEl.querySelectorAll<HTMLButtonElement>("[data-cmd]").forEach((btn) => {
        btn.addEventListener("mousedown", (e) => e.preventDefault()); // keep selection
        btn.addEventListener("click", () => {
          const cmd = btn.dataset.cmd;
          const chain = ed.chain().focus();
          if (cmd === "bold") chain.toggleBold().run();
          else if (cmd === "italic") chain.toggleItalic().run();
          else if (cmd === "strike") chain.toggleStrike().run();
          else if (cmd === "code") chain.toggleCode().run();
          else if (cmd === "link") toggleLink(ed);
          syncBubbleActive(ed);
        });
      });
      bubbleEl.querySelectorAll<HTMLButtonElement>("[data-color]").forEach((btn) => {
        btn.addEventListener("mousedown", (e) => e.preventDefault());
        btn.addEventListener("click", () => {
          const color = btn.dataset.color ?? "";
          const chain = ed.chain().focus();
          if (color) chain.setColor(color).run();
          else chain.unsetColor().run();
        });
      });
      // Reflect active marks on selection change.
      ed.on("selectionUpdate", () => syncBubbleActive(ed));
      ed.on("transaction", () => syncBubbleActive(ed));
    }

    function syncBubbleActive(ed: Editor): void {
      const map: Record<string, string> = {
        bold: "bold", italic: "italic", strike: "strike", code: "code", link: "link",
      };
      bubbleEl.querySelectorAll<HTMLButtonElement>("[data-cmd]").forEach((btn) => {
        const mark = map[btn.dataset.cmd ?? ""];
        const active = mark ? ed.isActive(mark) : false;
        btn.classList.toggle("is-active", active);
      });
    }

    function toggleLink(ed: Editor): void {
      if (ed.isActive("link")) {
        ed.chain().focus().unsetLink().run();
        return;
      }
      const prev = (ed.getAttributes("link").href as string) ?? "";
      const url = window.prompt("Link URL", prev || "https://");
      if (url === null) return;          // cancelled
      if (url === "") { ed.chain().focus().unsetLink().run(); return; }
      ed.chain().focus().extendMarkRange("link").setLink({ href: url }).run();
    }

    // ── render ────────────────────────────────────────────────────────
    let toastTimer: ReturnType<typeof setTimeout> | null = null;

    /**
     * Append `text` to `el`, wrapping every case-insensitive occurrence of
     * `needle` in a <mark>. XSS-safe: all text goes through textContent /
     * createTextNode — never innerHTML — so a note titled `<img onerror>` stays
     * inert. Empty needle → plain text fast-path.
     */
    function highlightInto(el: HTMLElement, text: string, needle: string): void {
      if (!needle) {
        el.textContent = text;
        return;
      }
      const lower = text.toLowerCase();
      let from = 0;
      let idx = lower.indexOf(needle);
      if (idx === -1) {
        el.textContent = text;
        return;
      }
      const frag = document.createDocumentFragment();
      while (idx !== -1) {
        if (idx > from) frag.appendChild(document.createTextNode(text.slice(from, idx)));
        const mark = document.createElement("mark");
        mark.textContent = text.slice(idx, idx + needle.length);
        frag.appendChild(mark);
        from = idx + needle.length;
        idx = lower.indexOf(needle, from);
      }
      if (from < text.length) frag.appendChild(document.createTextNode(text.slice(from)));
      el.appendChild(frag);
    }

    /** Build one sticky-note card <li>. `needle` (lowercased) highlights hits. */
    function buildCard(
      entry: ReturnType<typeof notesStore.get>["index"][number],
      activeId: string | null,
      needle: string,
    ): HTMLLIElement {
      const sw = swatchOf(entry.color);
      const li = document.createElement("li");
      li.setAttribute("role", "option");
      li.setAttribute("aria-selected", String(entry.id === activeId));
      li.dataset.id = entry.id;
      li.tabIndex = 0;
      const selected = entry.id === activeId;
      li.className =
        "sticky-card group relative cursor-pointer rounded-lg border p-3 " +
        (selected ? "ring-2 ring-[var(--color-accent)]" : "");
      li.style.backgroundColor = sw.bg;
      li.style.borderColor = sw.edge;
      li.style.color = sw.ink;
      // Tilt lives in a custom prop so CSS can compose it with a hover lift.
      li.style.setProperty("--rot", `${rotationFor(entry.id)}deg`);

      const titleRow = document.createElement("div");
      titleRow.className = "flex items-start gap-1.5";

      if (entry.pinned) {
        const pin = document.createElement("span");
        pin.textContent = "📌";
        pin.className = "shrink-0 text-xs leading-5";
        pin.setAttribute("aria-label", "Pinned");
        titleRow.appendChild(pin);
      }

      const title = document.createElement("div");
      title.className = "min-w-0 flex-1 truncate text-sm font-semibold";
      highlightInto(title, entry.title || "Untitled", needle);
      titleRow.appendChild(title);

      li.appendChild(titleRow);

      if (entry.preview) {
        const prev = document.createElement("div");
        prev.className = "mt-1 line-clamp-2 text-xs opacity-70";
        highlightInto(prev, entry.preview, needle);
        li.appendChild(prev);
      }

      return li;
    }

    /** A non-selectable group label row (e.g. "Pinned" / "Notes"). */
    function makeSectionHeader(label: string, count: number): HTMLLIElement {
      const li = document.createElement("li");
      li.setAttribute("role", "presentation");
      li.className = "section-header";
      const text = document.createElement("span");
      text.textContent = label;
      const badge = document.createElement("span");
      badge.className = "section-count";
      badge.textContent = String(count);
      li.append(text, badge);
      return li;
    }

    function render(state: ReturnType<typeof notesStore.get>): void {
      const query = state.query.trim();
      const needle = query.toLowerCase();
      const searching = needle.length > 0;
      const visible = searchNotes(state.index, state.query);

      // List vs empty vs no-results:
      //  - no notes at all → "fridge is empty" onboarding state
      //  - searching with zero matches → "no matches" state
      //  - otherwise → the list
      const hasNotes = state.index.length > 0;
      const noMatches = hasNotes && searching && visible.length === 0;
      const showList = hasNotes && !noMatches;
      listEl.classList.toggle("hidden", !showList);
      listEmptyEl.classList.toggle("hidden", hasNotes); // only for truly-empty
      listEmptyEl.classList.toggle("flex", !hasNotes);
      listNoResultsEl.classList.toggle("hidden", !noMatches);
      listNoResultsEl.classList.toggle("flex", noMatches);
      if (noMatches) noResultsQueryEl.textContent = query;

      // Build the rows. While searching we keep pure rank order (no grouping —
      // relevance matters more than pin status mid-search). Otherwise we group
      // Pinned above the rest, each with a labeled header (only when pins exist).
      const rows: HTMLLIElement[] = [];
      if (showList) {
        if (!searching) {
          const pinned = visible.filter((e) => e.pinned);
          const others = visible.filter((e) => !e.pinned);
          if (pinned.length > 0) {
            rows.push(makeSectionHeader("Pinned", pinned.length));
            for (const e of pinned) rows.push(buildCard(e, state.activeId, needle));
            // Only show the "Notes" header when there's a pinned group above it.
            if (others.length > 0) rows.push(makeSectionHeader("Notes", others.length));
          }
          for (const e of others) rows.push(buildCard(e, state.activeId, needle));
        } else {
          for (const e of visible) rows.push(buildCard(e, state.activeId, needle));
        }
      }
      listEl.replaceChildren(...rows);

      // Editor pane
      const hasActive = state.active !== null;
      editorHost.classList.toggle("hidden", !hasActive);
      editorEmptyEl.classList.toggle("hidden", hasActive);
      editorEmptyEl.classList.toggle("flex", !hasActive);
      toolbarEl.classList.toggle("hidden", !hasActive);
      toolbarEl.classList.toggle("flex", hasActive);

      if (state.active) {
        // Load this note's doc into the editor when the selection changes.
        // (No-op if the editor already holds this note — avoids clobbering the
        // caret while the user is typing in the same note.)
        if (editorNoteId !== state.active.id) {
          void loadNoteIntoEditor(state.active.id, state.active.doc);
        }
        pinBtn.setAttribute("aria-pressed", String(state.active.pinned));
        pinBtn.style.color = state.active.pinned ? "var(--color-accent-strong)" : "";
        pinBtn.title = state.active.pinned ? "Unpin note" : "Pin note";
        // Reflect the active note's color on the toolbar dot + keep an open
        // picker's active ring in sync (e.g. when a sibling tab recolors it).
        colorBtnDot.style.background = swatchOf(state.active.color).bg;
        if (isColorPopoverOpen()) syncColorPickerActive();
      } else {
        // Deselected — clear the editor's bound note so re-selecting reloads.
        editorNoteId = null;
        bubbleEl.style.visibility = "hidden";
        closeColorPopover();
      }
    }

    // ── toast ──────────────────────────────────────────────────────────
    function showUndoToast(title: string): void {
      toastMsg.textContent = title ? `Deleted “${trim(title)}”` : "Note deleted";
      toastAction.textContent = "Undo";
      toastEl.classList.remove("hidden");
      if (toastTimer) clearTimeout(toastTimer);
      toastTimer = setTimeout(() => toastEl.classList.add("hidden"), 5000);
    }
    function hideToast(): void {
      if (toastTimer) clearTimeout(toastTimer);
      toastEl.classList.add("hidden");
    }
    const trim = (s: string): string => (s.length > 28 ? s.slice(0, 28) + "…" : s);

    // ── color picker ─────────────────────────────────────────────────────
    // Build the 8 semantic swatches once (UX-CHARTER §3). Each button sets the
    // active note's color; the label tooltip doubles as the soft taxonomy.
    function buildColorPicker(): void {
      colorGrid.replaceChildren(
        ...COLOR_ORDER.map((color) => {
          const sw = SWATCHES[color];
          const btn = document.createElement("button");
          btn.type = "button";
          btn.dataset.color = color;
          btn.setAttribute("role", "menuitemradio");
          btn.title = sw.label;
          btn.setAttribute("aria-label", sw.label);
          btn.className = "color-swatch";
          btn.style.background = sw.bg;
          btn.style.borderColor = sw.edge;
          return btn;
        }),
      );
    }

    function openColorPopover(): void {
      syncColorPickerActive();
      colorPopover.classList.remove("hidden");
      colorBtn.setAttribute("aria-expanded", "true");
    }
    function closeColorPopover(): void {
      colorPopover.classList.add("hidden");
      colorBtn.setAttribute("aria-expanded", "false");
    }
    const isColorPopoverOpen = (): boolean =>
      !colorPopover.classList.contains("hidden");

    // Ring + check the active note's current color in the grid.
    function syncColorPickerActive(): void {
      const cur = notesStore.get().active?.color ?? null;
      colorGrid
        .querySelectorAll<HTMLButtonElement>("[data-color]")
        .forEach((b) => b.classList.toggle("is-active", b.dataset.color === cur));
    }

    // ── event wiring ────────────────────────────────────────────────────

    /** Focus the editor once it exists (created lazily on first select). */
    function focusEditorSoon(): void {
      const tryFocus = () => {
        if (editor) editor.commands.focus("end");
        else requestAnimationFrame(tryFocus);
      };
      requestAnimationFrame(tryFocus);
    }

    newBtn.addEventListener("click", () => {
      void notesStore.createNote();
      focusEditorSoon();
    });

    searchEl.addEventListener("input", () => notesStore.setQuery(searchEl.value));

    listEl.addEventListener("click", (e) => {
      const li = (e.target as HTMLElement).closest("li[data-id]") as HTMLElement | null;
      if (li?.dataset.id) void notesStore.selectNote(li.dataset.id);
    });
    listEl.addEventListener("keydown", (e) => {
      if (e.key !== "Enter" && e.key !== " ") return;
      const li = (e.target as HTMLElement).closest("li[data-id]") as HTMLElement | null;
      if (li?.dataset.id) {
        e.preventDefault();
        void notesStore.selectNote(li.dataset.id);
        focusEditorSoon();
      }
    });

    pinBtn.addEventListener("click", () => {
      const id = notesStore.get().activeId;
      if (id) void notesStore.togglePin(id);
    });

    deleteBtn.addEventListener("click", () => {
      const id = notesStore.get().activeId;
      if (id) void notesStore.deleteNote(id);
    });

    // Color picker: toggle popover, pick a swatch, dismiss on outside-click/Esc.
    buildColorPicker();
    colorBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      if (isColorPopoverOpen()) closeColorPopover();
      else openColorPopover();
    });
    colorGrid.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-color]");
      const color = btn?.dataset.color as StickyColor | undefined;
      const id = notesStore.get().activeId;
      if (color && id) {
        void notesStore.setColor(id, color);
        closeColorPopover();
      }
    });
    // Outside-click closes the popover (capture the document, ignore the button).
    document.addEventListener("click", (e) => {
      if (!isColorPopoverOpen()) return;
      const t = e.target as Node;
      if (!colorPopover.contains(t) && !colorBtn.contains(t)) closeColorPopover();
    });

    toastAction.addEventListener("click", () => {
      notesStore.undoDelete();
      hideToast();
    });

    notesStore.emitter.on("pendingDelete", ({ title }) => showUndoToast(title));

    // Flash "Saved ✓" when a persist completes (store flips saving true→false).
    let wasSaving = false;
    notesStore.emitter.on("change", (s) => {
      if (wasSaving && !s.saving) setSaveStatus("saved");
      wasSaving = s.saving;
    });

    // Surface a persist failure as a toast.
    notesStore.emitter.on("error", ({ message }) => {
      toastMsg.textContent = message;
      toastAction.textContent = "";
      toastEl.classList.remove("hidden");
      if (toastTimer) clearTimeout(toastTimer);
      toastTimer = setTimeout(() => toastEl.classList.add("hidden"), 4000);
    });

    // Surface a cross-tab info notice (e.g. "deleted in another tab").
    notesStore.emitter.on("notice", ({ message }) => {
      toastMsg.textContent = message;
      toastAction.textContent = "";
      toastEl.classList.remove("hidden");
      if (toastTimer) clearTimeout(toastTimer);
      toastTimer = setTimeout(() => toastEl.classList.add("hidden"), 4000);
    });

    // A sibling tab edited the note we're viewing. Reload the editor body to
    // reflect it — but ONLY if the user isn't mid-edit (no pending debounce),
    // so we never yank the caret out from under active typing (§7 limitation:
    // simultaneous same-note typing is still last-saver-wins).
    notesStore.emitter.on("remoteActive", ({ id, doc }) => {
      if (saveDebounce) return; // user is actively typing — don't clobber
      void loadNoteIntoEditor(id, doc as JSONContent, true);
    });

    // Keyboard: N = new, / = search (when not typing)
    document.addEventListener("keydown", (e) => {
      // Escape closes the color popover first (works even with editor focused).
      if (e.key === "Escape" && isColorPopoverOpen()) {
        e.preventDefault();
        closeColorPopover();
        return;
      }
      const el = document.activeElement as HTMLElement | null;
      // Escape in the search box: clear the query (if any) then blur. This is a
      // context-aware Esc — it works WHILE the input is focused, so it must run
      // before the generic "typing → bail" guard below.
      if (e.key === "Escape" && el === searchEl) {
        e.preventDefault();
        if (searchEl.value) {
          searchEl.value = "";
          notesStore.setQuery("");
        } else {
          searchEl.blur();
        }
        return;
      }
      const typing =
        el &&
        (el.tagName === "INPUT" ||
          el.tagName === "TEXTAREA" ||
          el.isContentEditable); // .ProseMirror is contentEditable → covered
      if (typing) return;
      if (e.key === "n" || e.key === "N") {
        e.preventDefault();
        void notesStore.createNote();
        focusEditorSoon();
      } else if (e.key === "/") {
        e.preventDefault();
        searchEl.focus();
        searchEl.select();
      }
    });

    // Flush any pending hard-delete + pending save before the tab unloads.
    window.addEventListener("pagehide", () => {
      if (saveDebounce && editor) {
        clearTimeout(saveDebounce);
        void notesStore.updateActiveDoc(editor.getJSON() as JSONContent);
      }
      notesStore.flushPendingDelete();
    });

    // ── boot ────────────────────────────────────────────────────────────
    notesStore.emitter.on("change", render);
    (async () => {
      const adapter = await pickStorage();
      await notesStore.init(adapter);
      render(notesStore.get());
    })();
  </script>
</Layout>
