---
/**
 * /app — the AlwaysOnTopNotes notes app.
 *
 * Phase 2 · Commit 6: two-pane shell + in-memory CRUD.
 * - Left: searchable list of sticky-note cards (create / select / delete).
 * - Right: editor pane (plain <textarea> for now; Tiptap lands in commit 8).
 * - State lives in `notesStore`, persisted through a StorageAdapter. Commit 6
 *   uses the in-memory adapter, so notes are lost on reload — that's expected
 *   until commit 7 wires IndexedDB. Everything else is final.
 *
 * Single-island pattern (mirrors FTN's transfer.astro): one <script> below
 * owns all interactivity; the markup here is just the static shell it hydrates.
 */
import Layout from "../layouts/Layout.astro";
import { site } from "../site.config";
---

<Layout
  title="Notes"
  description="Your private sticky notes. Nothing uploads — notes live on your device."
  noindex={true}
>
  <div id="app-root" class="flex h-[100dvh] flex-col overflow-hidden">
    {/* Slim top bar — brand home link + status, keeps the app chrome minimal */}
    <header
      class="flex h-12 shrink-0 items-center justify-between border-b border-[var(--color-border)] bg-[var(--color-bg)] px-3"
    >
      <a
        href="/"
        class="flex items-center gap-2 text-[var(--color-fg)] no-underline hover:no-underline hover:opacity-80"
        aria-label={`${site.name} — home`}
      >
        <svg width="20" height="20" viewBox="0 0 32 32" fill="none" aria-hidden="true">
          <rect x="4" y="6" width="24" height="24" rx="2" fill="var(--color-accent)" transform="rotate(-3 16 18)"></rect>
          <rect x="4" y="6" width="24" height="3" fill="#eab308" transform="rotate(-3 16 18)"></rect>
        </svg>
        <span class="text-sm font-semibold tracking-tight">{site.name}</span>
      </a>

      {/* In-PiP note switcher — fills the otherwise-empty header strip when the
          float is open (brand + pip-toggle are hidden in PiP). Lets the user
          flip between notes WITHOUT bringing the app back, and surfaces the
          active note's title in DOM we control (the browser's PiP title bar
          can't be reliably styled). Hidden in the two-pane app; shown only
          under :where(.pip-mode) via CSS. Buttons reuse navigateList(±1). */}
      <div
        id="pip-switcher"
        class="hidden min-w-0 items-center justify-center gap-1"
        role="group"
        aria-label="Switch note"
      >
        <button
          id="pip-prev"
          type="button"
          class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-md text-[var(--color-fg-muted)] transition-colors hover:bg-[var(--color-bg-muted)] hover:text-[var(--color-fg)] disabled:pointer-events-none disabled:opacity-30"
          aria-label="Previous note"
          title="Previous note (K)"
        >
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg>
        </button>
        <div id="pip-title-clip" class="min-w-0 max-w-[180px]">
          <button
            id="pip-title"
            type="button"
            class="block w-full text-center text-[13px] font-semibold leading-7 text-[var(--color-fg)] transition-colors"
            title="Bring back the full app"
            aria-label="Active note — click to bring the app back"
          ><span id="pip-title-text" class="block w-full truncate"></span></button>
        </div>
        <span
          id="pip-pos"
          class="shrink-0 text-[11px] tabular-nums text-[var(--color-fg-subtle)]"
          aria-hidden="true"
        ></span>
        <button
          id="pip-next"
          type="button"
          class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-md text-[var(--color-fg-muted)] transition-colors hover:bg-[var(--color-bg-muted)] hover:text-[var(--color-fg)] disabled:pointer-events-none disabled:opacity-30"
          aria-label="Next note"
          title="Next note (J)"
        >
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
        </button>
        {/* Stack switcher toggle — opens the 3D deck to jump to ANY note fast.
            Shown only in PiP (the two-pane app has the full sidebar list). */}
        <button
          id="pip-stack-toggle"
          type="button"
          class="ml-0.5 inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-md text-[var(--color-fg-muted)] transition-colors hover:bg-[var(--color-bg-muted)] hover:text-[var(--color-fg)]"
          aria-label="Browse all notes"
          title="Browse all notes (stack)"
          aria-expanded="false"
        >
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="4" y="3" width="16" height="5" rx="1.5"></rect>
            <rect x="6" y="10" width="12" height="4" rx="1.5" opacity="0.7"></rect>
            <rect x="8" y="16" width="8" height="4" rx="1.5" opacity="0.45"></rect>
          </svg>
        </button>
      </div>
      <div class="flex items-center gap-3">
        {/* Save status — wired in commit 8; placeholder reserved now */}
        <span
          id="save-status"
          class="text-xs text-[var(--color-fg-subtle)] tabular-nums"
          aria-live="polite"
        ></span>
        {/* Theme toggle — cycles dark → light → system. Icons are swapped in JS
            (NOT dark:* utilities — this project themes via data-theme, where
            dark:* would silently no-op). Only one icon is shown at a time. */}
        <button
          id="theme-toggle"
          type="button"
          class="inline-flex h-8 w-8 items-center justify-center rounded-md text-[var(--color-fg-muted)] transition-colors hover:bg-[var(--color-bg-muted)] hover:text-[var(--color-fg)]"
          aria-label="Theme"
          title="Theme"
        >
          {/* moon — shown when the active theme is dark */}
          <svg id="theme-icon-dark" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
          </svg>
          {/* sun — shown when the active theme is light */}
          <svg id="theme-icon-light" class="hidden" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
          </svg>
          {/* monitor — shown when following the system preference */}
          <svg id="theme-icon-system" class="hidden" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect width="20" height="14" x="2" y="3" rx="2"></rect>
            <path d="M8 21h8M12 17v4"></path>
          </svg>
        </button>
        {/* Document PiP toggle — pops the app shell into a floating window.
            Hidden by default; the island unhides it only on Chromium 116+. */}
        <button
          id="pip-toggle"
          type="button"
          class="hidden inline-flex h-8 w-8 items-center justify-center rounded-md text-[var(--color-fg-muted)] transition-colors hover:bg-[var(--color-bg-muted)] hover:text-[var(--color-fg)]"
          aria-label="Pop out into floating window"
          title="Pop out into a floating window"
        >
          <svg id="pip-icon-open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 9V6a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h4"></path>
            <rect width="10" height="7" x="12" y="13" rx="2"></rect>
          </svg>
          <svg id="pip-icon-close" class="hidden" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M14 9V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h3"></path>
            <path d="m17 13-4 4 4 4"></path>
            <path d="M22 17h-9"></path>
          </svg>
        </button>
        <span id="device-badge" class="hidden text-xs text-[var(--color-fg-subtle)] sm:inline">
          🔒 On your device
        </span>
      </div>
    </header>

    {/* Two-pane body */}
    <div class="flex min-h-0 flex-1">
      {/* ── Sidebar ─────────────────────────────────────────── */}
      <aside
        class="flex w-full max-w-[320px] shrink-0 flex-col border-r border-[var(--color-border)] bg-[var(--color-bg-subtle)] md:w-[300px]"
        aria-label="Notes list"
      >
        {/* Search + new */}
        <div class="flex items-center gap-2 border-b border-[var(--color-border)] p-2.5">
          <div class="relative flex-1">
            <svg
              class="pointer-events-none absolute left-2.5 top-1/2 -translate-y-1/2 text-[var(--color-fg-subtle)]"
              width="15" height="15" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"
            >
              <circle cx="11" cy="11" r="7"></circle>
              <path d="m21 21-4.3-4.3"></path>
            </svg>
            <input
              id="search-input"
              type="text"
              placeholder="Search notes…"
              autocomplete="off"
              spellcheck="false"
              aria-label="Search notes"
              class="h-9 w-full rounded-md border border-[var(--color-border)] bg-[var(--color-bg)] pl-8 pr-3 text-sm text-[var(--color-fg)] placeholder:text-[var(--color-fg-subtle)] focus:border-[var(--color-accent)] focus:outline-none"
            />
          </div>
          <button
            id="new-note-btn"
            type="button"
            title="New note (N)"
            aria-label="New note"
            class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-md bg-[var(--color-fg)] text-[var(--color-bg)] transition-opacity hover:opacity-90 active:scale-95"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <path d="M12 5v14M5 12h14"></path>
            </svg>
          </button>
          {/* Overflow menu — bulk export / import (kept out of the toolbar so it
              stays uncluttered). Toggled by #more-btn; dismiss on outside-click/Esc. */}
          <div class="relative shrink-0">
            <button
              id="more-btn"
              type="button"
              title="More actions"
              aria-label="More actions"
              aria-haspopup="true"
              aria-expanded="false"
              class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-[var(--color-border)] text-[var(--color-fg-muted)] transition-colors hover:bg-[var(--color-bg-muted)] hover:text-[var(--color-fg)]"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <circle cx="12" cy="5" r="1.6"></circle><circle cx="12" cy="12" r="1.6"></circle><circle cx="12" cy="19" r="1.6"></circle>
              </svg>
            </button>
            <div
              id="more-menu"
              class="absolute right-0 top-11 z-40 hidden w-52 rounded-xl border border-[var(--color-border)] bg-[var(--color-bg)] p-1.5 shadow-xl"
              role="menu"
              aria-label="More actions"
            >
              <button
                id="export-all-btn"
                type="button"
                role="menuitem"
                class="flex w-full items-center gap-2.5 rounded-md px-2.5 py-2 text-left text-sm text-[var(--color-fg)] transition-colors hover:bg-[var(--color-bg-muted)]"
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m0 0 4-4m-4 4-4-4M5 17v2a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-2"></path></svg>
                Export all (.zip)
              </button>
              <button
                id="import-btn"
                type="button"
                role="menuitem"
                class="flex w-full items-center gap-2.5 rounded-md px-2.5 py-2 text-left text-sm text-[var(--color-fg)] transition-colors hover:bg-[var(--color-bg-muted)]"
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 15V3m-4 4 4-4 4 4M5 17v2a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-2"></path></svg>
                Import .md
              </button>
            </div>
          </div>
        </div>

        {/* Note list (populated by the island) */}
        <ul
          id="note-list"
          class="nice-scroll flex min-h-0 flex-1 flex-col gap-2 overflow-y-auto p-2.5"
          role="listbox"
          aria-label="Your notes"
        ></ul>

        {/* Empty state (toggled by the island) */}
        <div
          id="list-empty"
          class="hidden flex-1 flex-col items-center justify-center gap-3 p-6 text-center"
        >
          <div class="text-3xl">🗒️</div>
          <p class="text-sm text-[var(--color-fg-muted)]">
            Your fridge is empty.<br />Press <kbd class="rounded border border-[var(--color-border)] bg-[var(--color-bg-muted)] px-1.5 py-0.5 text-xs font-medium">N</kbd> to start.
          </p>
        </div>

        {/* No-results state (toggled by the island when a search matches nothing) */}
        <div
          id="list-no-results"
          class="hidden flex-1 flex-col items-center justify-center gap-3 p-6 text-center"
        >
          <div class="text-3xl">🔍</div>
          <p class="text-sm text-[var(--color-fg-muted)]">
            No notes match “<span id="no-results-query" class="font-semibold text-[var(--color-fg)]"></span>”.
          </p>
        </div>
      </aside>

      {/* ── Editor pane ─────────────────────────────────────── */}
      <main class="relative flex min-w-0 flex-1 flex-col bg-[var(--color-bg)]">
        {/* Editor toolbar (color + pin + delete) — shown only with a selection */}
        <div
          id="editor-toolbar"
          class="hidden h-12 shrink-0 items-center justify-between border-b border-[var(--color-border)] px-3"
        >
          <div class="flex items-center gap-1.5">
            <button
              id="color-btn"
              type="button"
              title="Note color"
              aria-label="Note color"
              aria-haspopup="true"
              aria-expanded="false"
              class="inline-flex h-8 w-8 items-center justify-center rounded-md text-[var(--color-fg-muted)] transition-colors hover:bg-[var(--color-bg-muted)] hover:text-[var(--color-fg)]"
            >
              <span
                id="color-btn-dot"
                class="h-4 w-4 rounded-full"
                style="background:#fef9c3"
                aria-hidden="true"
              ></span>
            </button>
            <button
              id="pin-btn"
              type="button"
              title="Pin note"
              aria-label="Pin note"
              class="inline-flex h-8 w-8 items-center justify-center rounded-md text-[var(--color-fg-muted)] transition-colors hover:bg-[var(--color-bg-muted)] hover:text-[var(--color-fg)]"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 17v5M9 10.76a2 2 0 0 1-1.11 1.79l-1.78.9A2 2 0 0 0 5 15.24V16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-.76a2 2 0 0 0-1.11-1.79l-1.78-.9A2 2 0 0 1 15 10.76V7a1 1 0 0 1 1-1 2 2 0 0 0 0-4H8a2 2 0 0 0 0 4 1 1 0 0 1 1 1z"></path>
              </svg>
            </button>
            <button
              id="export-btn"
              type="button"
              title="Export this note as Markdown"
              aria-label="Export this note as Markdown"
              class="inline-flex h-8 w-8 items-center justify-center rounded-md text-[var(--color-fg-muted)] transition-colors hover:bg-[var(--color-bg-muted)] hover:text-[var(--color-fg)]"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 3v12m0 0 4-4m-4 4-4-4M5 17v2a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-2"></path>
              </svg>
            </button>
            <button
              id="md-toggle-btn"
              type="button"
              title="Edit as Markdown"
              aria-label="Edit as Markdown"
              aria-pressed="false"
              class="inline-flex h-8 w-8 items-center justify-center rounded-md text-[var(--color-fg-muted)] transition-colors hover:bg-[var(--color-bg-muted)] hover:text-[var(--color-fg)]"
            >
              {/* Markdown wordmark glyph (the standard "M↓" badge). */}
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2.5" y="5" width="19" height="14" rx="2.5"></rect>
                <path d="M6 15V9l3 3 3-3v6"></path>
                <path d="M16.5 9v4.5m0 0L15 12m1.5 1.5L18 12"></path>
              </svg>
            </button>
          </div>
          <button
            id="delete-btn"
            type="button"
            title="Delete note"
            aria-label="Delete note"
            class="inline-flex h-8 w-8 items-center justify-center rounded-md text-[var(--color-fg-muted)] transition-colors hover:bg-[color-mix(in_srgb,var(--color-danger)_14%,transparent)] hover:text-[var(--color-danger)]"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M10 11v6M14 11v6"></path>
            </svg>
          </button>
        </div>

        {/* Color-picker popover (8 semantic swatches — UX-CHARTER §3). Anchored
            under the color button; toggled open via #color-btn. Built once here,
            populated + wired in the island. */}
        <div
          id="color-popover"
          class="absolute left-3 top-12 z-40 hidden w-[180px] rounded-xl border border-[var(--color-border)] bg-[var(--color-bg)] p-2 shadow-xl"
          role="menu"
          aria-label="Note color"
        >
          <div id="color-grid" class="grid grid-cols-4 gap-1.5"></div>
        </div>

        {/* The editor surface */}
        <div class="nice-scroll min-h-0 flex-1 overflow-y-auto">
          {/* Tiptap mounts its .ProseMirror into this host on first select. */}
          <div
            id="editor-host"
            class="hidden h-full px-6 py-5"
          ></div>

          {/* Raw Markdown editor (toggled on via #md-toggle-btn). Same paper
              surface; monospace. Hidden by default — Preview (Tiptap) is the
              default mode. */}
          <textarea
            id="md-editor"
            class="hidden h-full w-full resize-none bg-transparent px-6 py-5 font-mono text-sm leading-relaxed text-[var(--note-ink,var(--color-fg))] outline-none"
            spellcheck="false"
            autocomplete="off"
            autocapitalize="off"
            aria-label="Markdown source"
            placeholder="# Write in Markdown…"
          ></textarea>

          {/* No-selection state */}
          <div
            id="editor-empty"
            class="flex h-full flex-col items-center justify-center gap-3 p-6 text-center"
          >
            <div class="text-4xl">📝</div>
            <p class="max-w-xs text-sm text-[var(--color-fg-muted)]">
              Select a note, or press
              <kbd class="rounded border border-[var(--color-border)] bg-[var(--color-bg-muted)] px-1.5 py-0.5 text-xs font-medium">N</kbd>
              to create one.
            </p>
          </div>
        </div>
      </main>

      {/* PiP 3D stack switcher host. Inside #app-root so it travels into the
          float; shown only in .pip-mode + when JS adds .is-open. Contents are
          built by pipStack.ts. */}
      <div id="pip-stack" class="hidden"></div>
    </div>

    {/* Hidden file input for "Import .md" (picker path). The drag-drop overlay
        below is the other import path. Both feed the same importMarkdownFiles(). */}
    <input
      id="import-input"
      type="file"
      accept=".md,.markdown,.mdown,.mkd,.txt,text/markdown,text/plain"
      multiple
      class="hidden"
      aria-hidden="true"
    />

    {/* Full-window drag-drop import overlay. Shown while a file is dragged over
        the window; dropping .md files imports them as notes. */}
    <div
      id="drop-overlay"
      class="pointer-events-none fixed inset-0 z-[70] hidden items-center justify-center bg-[color-mix(in_srgb,var(--color-bg)_82%,transparent)] backdrop-blur-sm"
      aria-hidden="true"
    >
      <div class="flex flex-col items-center gap-4 rounded-2xl border-2 border-dashed border-[var(--color-accent)] bg-[var(--color-bg)] px-12 py-10 text-center shadow-2xl">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 15V3m0 12-4-4m4 4 4-4M5 17v2a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-2"></path></svg>
        <div>
          <p class="text-base font-semibold text-[var(--color-fg)]">Drop to import</p>
          <p class="mt-1 text-sm text-[var(--color-fg-muted)]">Each .md file becomes a note</p>
        </div>
      </div>
    </div>

    {/* Floating selection toolbar (Tiptap BubbleMenu host). Hidden until a
        text selection exists; positioned by @floating-ui via the extension. */}
    <div
      id="bubble-menu"
      class="flex items-center gap-0.5 rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-subtle)] p-1 shadow-lg"
      role="toolbar"
      aria-label="Text formatting"
    >
      <button type="button" data-cmd="bold" title="Bold (Ctrl/Cmd+B)" aria-label="Bold" class="bubble-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 4h8a4 4 0 0 1 0 8H6zM6 12h9a4 4 0 0 1 0 8H6z"></path></svg>
      </button>
      <button type="button" data-cmd="italic" title="Italic (Ctrl/Cmd+I)" aria-label="Italic" class="bubble-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 4h-9M14 20H5M15 4 9 20"></path></svg>
      </button>
      <button type="button" data-cmd="strike" title="Strikethrough" aria-label="Strikethrough" class="bubble-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 4H9a3 3 0 0 0-2.83 4M14 12a4 4 0 0 1 0 8H6M4 12h16"></path></svg>
      </button>
      <button type="button" data-cmd="code" title="Inline code" aria-label="Inline code" class="bubble-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m16 18 6-6-6-6M8 6l-6 6 6 6"></path></svg>
      </button>
      <span class="mx-0.5 h-5 w-px bg-[var(--color-border)]" aria-hidden="true"></span>
      <button type="button" data-cmd="link" title="Add/edit link (Ctrl/Cmd+K)" aria-label="Add link" class="bubble-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
      </button>
    </div>

    {/* Undo-delete toast (single, replaces — never stacks) */}
    <div
      id="toast"
      class="pointer-events-none fixed bottom-4 left-1/2 z-50 hidden -translate-x-1/2"
      role="status"
      aria-live="polite"
    >
      <div class="pointer-events-auto flex items-center gap-3 rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-subtle)] px-4 py-2.5 shadow-lg">
        <span id="toast-msg" class="text-sm text-[var(--color-fg)]"></span>
        <button
          id="toast-action"
          type="button"
          class="text-sm font-semibold text-[var(--color-accent-strong)] hover:underline"
        ></button>
      </div>
    </div>

    {/* Keyboard-shortcuts modal (opened with `?`). Backdrop + centered card. */}
    <div
      id="shortcuts-modal"
      class="fixed inset-0 z-[70] hidden items-center justify-center p-4"
      role="dialog"
      aria-modal="true"
      aria-labelledby="shortcuts-title"
    >
      <div id="shortcuts-backdrop" class="absolute inset-0 bg-black/50"></div>
      <div class="relative w-full max-w-sm rounded-xl border border-[var(--color-border)] bg-[var(--color-bg)] p-5 shadow-2xl">
        <div class="mb-3 flex items-center justify-between">
          <h2 id="shortcuts-title" class="text-base font-semibold text-[var(--color-fg)]">
            Keyboard shortcuts
          </h2>
          <button
            id="shortcuts-close"
            type="button"
            aria-label="Close"
            class="inline-flex h-7 w-7 items-center justify-center rounded-md text-[var(--color-fg-muted)] transition-colors hover:bg-[var(--color-bg-muted)] hover:text-[var(--color-fg)]"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"></path></svg>
          </button>
        </div>
        <dl class="flex flex-col gap-0.5 text-sm">
          <div class="shortcut-row"><dt>New note</dt><dd><kbd class="kbd">N</kbd></dd></div>
          <div class="shortcut-row"><dt>Focus search</dt><dd><kbd class="kbd">/</kbd></dd></div>
          <div class="shortcut-row"><dt>Move down / up</dt><dd><kbd class="kbd">J</kbd><kbd class="kbd">K</kbd></dd></div>
          <div class="shortcut-row"><dt>Bold / italic / link</dt><dd><kbd class="kbd">Ctrl</kbd>+<kbd class="kbd">B</kbd> / <kbd class="kbd">I</kbd> / <kbd class="kbd">K</kbd></dd></div>
          <div class="shortcut-row"><dt>Force save</dt><dd><kbd class="kbd">Ctrl</kbd>+<kbd class="kbd">S</kbd></dd></div>
          <div class="shortcut-row"><dt>Delete note</dt><dd><kbd class="kbd">Ctrl</kbd>+<kbd class="kbd">⌫</kbd></dd></div>
          <div class="shortcut-row"><dt>Clear search / close</dt><dd><kbd class="kbd">Esc</kbd></dd></div>
          <div class="shortcut-row"><dt>This menu</dt><dd><kbd class="kbd">?</kbd></dd></div>
        </dl>
        <p class="mt-3 text-xs text-[var(--color-fg-subtle)]">
          On Mac, use <kbd class="kbd">⌘</kbd> instead of <kbd class="kbd">Ctrl</kbd>.
        </p>
      </div>
    </div>
  </div>

  {/* PiP placeholder — shown in the origin tab while the app shell is floating
      in the PiP window. SIBLING of #app-root (not a child) so the reparent
      that empties #app-root's slot leaves this behind to fill the origin tab. */}
  <div
    id="pip-placeholder"
    class="hidden h-[100dvh] flex-col items-center justify-center gap-4 bg-[var(--color-bg)] p-8 text-center"
  >
    <div class="text-5xl">📺</div>
    <h2 class="text-lg font-semibold text-[var(--color-fg)]">
      Floating in a Picture-in-Picture window
    </h2>
    <p class="max-w-sm text-sm text-[var(--color-fg-muted)]">
      Your note is in a small always-on-top window. Keep it visible while you
      work in another app.
    </p>
    <button
      id="pip-bring-back"
      type="button"
      class="inline-flex items-center gap-2 rounded-md bg-[var(--color-fg)] px-4 py-2 text-sm font-semibold text-[var(--color-bg)] transition-opacity hover:opacity-90 active:scale-95"
    >
      Bring back to this tab
    </button>
  </div>

  <script>
    import { notesStore } from "../lib/notesStore";
    import { searchNotes } from "../lib/searchNotes";
    import { swatchOf, rotationFor, glowVars, SWATCHES, COLOR_ORDER } from "../lib/colors";
    import { pickStorage } from "../lib/storage";
    import { isPipSupported, isPipOpen, openPip, closePip, pipWindowRef } from "../lib/pipWindow";
    import { initPipTour } from "../lib/pipTour";
    import { hasWelcomed, markWelcomed, welcomeDoc, WELCOME_COLOR } from "../lib/welcome";
    import { exportNote, exportAllNotes } from "../lib/exportNotes";
    import { importMarkdownFiles } from "../lib/importNotes";
    import { docToMarkdown } from "../lib/markdown/serialize";
    import { markdownToDoc } from "../lib/markdown/parse";
    import { initPwaInstall } from "../lib/pwaInstall";
    import { initThemeToggle } from "../lib/themeToggle";
    import { initPipStack } from "../lib/pipStack";
    import type { StickyColor } from "../lib/types";
    import type { Editor } from "@tiptap/core";
    import type { JSONContent } from "../lib/types";

    // ── element handles ───────────────────────────────────────────────
    const $ = <T extends HTMLElement = HTMLElement>(id: string): T =>
      document.getElementById(id) as T;

    const listEl = $<HTMLUListElement>("note-list");
    const listEmptyEl = $("list-empty");
    const listNoResultsEl = $("list-no-results");
    const noResultsQueryEl = $("no-results-query");
    const searchEl = $<HTMLInputElement>("search-input");
    const newBtn = $<HTMLButtonElement>("new-note-btn");
    const editorHost = $("editor-host");
    const mdEditor = $<HTMLTextAreaElement>("md-editor");
    const editorEmptyEl = $("editor-empty");
    const toolbarEl = $("editor-toolbar");
    const pinBtn = $<HTMLButtonElement>("pin-btn");
    const colorBtn = $<HTMLButtonElement>("color-btn");
    const colorBtnDot = $("color-btn-dot");
    const colorPopover = $("color-popover");
    const colorGrid = $("color-grid");
    const deleteBtn = $<HTMLButtonElement>("delete-btn");
    const exportBtn = $<HTMLButtonElement>("export-btn");
    const mdToggleBtn = $<HTMLButtonElement>("md-toggle-btn");
    const moreBtn = $<HTMLButtonElement>("more-btn");
    const moreMenu = $("more-menu");
    const exportAllBtn = $<HTMLButtonElement>("export-all-btn");
    const importBtn = $<HTMLButtonElement>("import-btn");
    const importInput = $<HTMLInputElement>("import-input");
    const dropOverlay = $("drop-overlay");
    const bubbleEl = $("bubble-menu");
    const shortcutsModal = $("shortcuts-modal");
    const shortcutsClose = $<HTMLButtonElement>("shortcuts-close");
    const shortcutsBackdrop = $("shortcuts-backdrop");
    const toastEl = $("toast");
    const toastMsg = $("toast-msg");
    const toastAction = $<HTMLButtonElement>("toast-action");

    // In-PiP note switcher (shown only inside the float; see :where(.pip-mode)).
    const pipPrevBtn = $<HTMLButtonElement>("pip-prev");
    const pipNextBtn = $<HTMLButtonElement>("pip-next");
    const pipTitleBtn = $<HTMLButtonElement>("pip-title");
    const pipTitleText = $("pip-title-text"); // inner span holds the text (truncates)
    const pipPosEl = $("pip-pos");

    // ── Tiptap editor (lazy — created on first note select) ───────────
    let editor: Editor | null = null;
    let editorNoteId: string | null = null;   // which note the editor currently holds
    let applyingProgrammatic = false;          // guard: ignore onUpdate during setContent
    let saveDebounce: ReturnType<typeof setTimeout> | null = null;
    let savedFlashTimer: ReturnType<typeof setTimeout> | null = null;

    async function ensureEditor(): Promise<Editor> {
      if (editor) return editor;
      // Lazy-load Tiptap so the sidebar paints before the editor chunk arrives.
      const { makeEditor } = await import("../lib/tiptapSetup");
      editor = makeEditor({
        element: editorHost,
        content: { type: "doc", content: [{ type: "paragraph" }] },
        bubbleElement: bubbleEl,
        onUpdate: (doc: JSONContent) => {
          if (applyingProgrammatic) return; // setContent shouldn't trigger a save
          scheduleSave(doc);
        },
      });
      wireBubbleToolbar(editor);
      // Make links followable. Tiptap's link has openOnClick:false (so clicking
      // inside the editor places the caret instead of navigating while you edit)
      // — but users expect to actually FOLLOW a link. Compromise: a plain click
      // with NO text selection opens it in a new tab; if the user is selecting
      // text (or Shift/drag), we leave the caret alone. Cmd/Ctrl+click also opens
      // (the familiar "open in new tab" gesture). Delegated off the host so it
      // survives the editor's internal re-renders.
      editorHost.addEventListener("click", (e) => {
        const a = (e.target as HTMLElement).closest("a");
        if (!a || !editorHost.contains(a)) return;
        const href = a.getAttribute("href");
        if (!href) return;
        // Don't hijack a click that's the tail end of a text selection drag.
        const sel = editorHost.ownerDocument.getSelection();
        const selecting = sel && !sel.isCollapsed && sel.toString().length > 0;
        if (selecting && !(e.metaKey || e.ctrlKey)) return;
        e.preventDefault();
        window.open(href, "_blank", "noopener,noreferrer");
      });
      return editor;
    }

    /** Load a note's doc into the editor (create editor on first use).
     *  `force` reloads even if the same note is already shown — used when a
     *  sibling tab edited the active note and we want to reflect it. */
    async function loadNoteIntoEditor(
      noteId: string,
      doc: JSONContent,
      force = false,
    ): Promise<void> {
      const ed = await ensureEditor();
      if (editorNoteId === noteId && !force) return; // already showing this note
      editorNoteId = noteId;
      applyingProgrammatic = true;
      // `false` = don't emit an update transaction for this programmatic set.
      ed.commands.setContent(doc as Record<string, unknown>, { emitUpdate: false });
      applyingProgrammatic = false;
    }

    /** 500ms debounced autosave → store.updateActiveDoc. A non-null
     *  `saveDebounce` means an edit is pending (the user is actively typing);
     *  we null it after the save fires so remote-sync can tell idle from busy. */
    function scheduleSave(doc: JSONContent): void {
      setSaveStatus("saving");
      if (saveDebounce) clearTimeout(saveDebounce);
      saveDebounce = setTimeout(() => {
        saveDebounce = null;
        void notesStore.updateActiveDoc(doc);
      }, 500);
    }

    // ── Markdown edit mode (raw-source ⇄ WYSIWYG toggle) ───────────────
    // The toolbar's #md-toggle-btn flips the editor surface between the Tiptap
    // WYSIWYG (default "Preview") and a raw Markdown <textarea> ("Markdown").
    // Both edit the SAME note and funnel through the SAME debounced store path
    // (updateActiveDoc), so title/preview/cross-tab-sync stay consistent.
    let mdMode = false;
    let mdNoteId: string | null = null; // which note the textarea currently holds

    /** Debounced autosave for the textarea path: parse MD → doc → store.
     *  Reuses `saveDebounce` so the "is the user typing" idle-gate (used by
     *  remoteActive cross-tab reload) treats MD typing identically to WYSIWYG.
     *  Captures the note id at schedule time and drops the save if the user
     *  switched notes before it fired — a stale save must never write one note's
     *  text onto another. */
    function scheduleMdSave(text: string): void {
      setSaveStatus("saving");
      const forId = notesStore.get().activeId;
      if (saveDebounce) clearTimeout(saveDebounce);
      saveDebounce = setTimeout(() => {
        saveDebounce = null;
        if (notesStore.get().activeId !== forId) return; // switched away — drop
        void notesStore.updateActiveDoc(markdownToDoc(text) as JSONContent);
      }, 500);
    }

    /** Reflect MD vs Preview on the DOM: which surface shows + button state.
     *  Called by render() too, so switching notes / empty-state stays correct. */
    function syncEditorMode(hasActive: boolean): void {
      // Tiptap host shows only in Preview mode with an active note; the textarea
      // shows only in Markdown mode with an active note.
      editorHost.classList.toggle("hidden", !hasActive || mdMode);
      mdEditor.classList.toggle("hidden", !hasActive || !mdMode);
      mdToggleBtn.setAttribute("aria-pressed", String(mdMode));
      mdToggleBtn.classList.toggle("is-active", mdMode);
      mdToggleBtn.title = mdMode ? "Back to rich text" : "Edit as Markdown";
      mdToggleBtn.setAttribute("aria-label", mdToggleBtn.title);
    }

    /** Enter raw-Markdown mode: serialize the active note's doc into the
     *  textarea. Flushes any pending WYSIWYG save first so we serialize the
     *  freshest doc. */
    async function enterMarkdownMode(): Promise<void> {
      const active = notesStore.get().active;
      if (!active) return;
      // Flush a pending Tiptap autosave so we serialize the latest content.
      if (saveDebounce) {
        clearTimeout(saveDebounce);
        saveDebounce = null;
        if (editor) await notesStore.updateActiveDoc(editor.getJSON() as JSONContent);
      }
      mdMode = true;
      const doc = notesStore.get().active?.doc ?? active.doc;
      mdEditor.value = docToMarkdown(doc as JSONContent);
      mdNoteId = active.id;
      syncEditorMode(true);
      mdEditor.focus();
    }

    /** Exit raw-Markdown mode: parse the textarea back into a doc, persist it,
     *  and re-render it in the Tiptap editor. */
    async function exitMarkdownMode(): Promise<void> {
      // Flush a pending MD autosave first (so we don't lose the last keystrokes),
      // then parse the current textarea content as the source of truth.
      if (saveDebounce) { clearTimeout(saveDebounce); saveDebounce = null; }
      const doc = markdownToDoc(mdEditor.value) as JSONContent;
      mdMode = false;
      const active = notesStore.get().active;
      if (active) {
        await notesStore.updateActiveDoc(doc);
        await loadNoteIntoEditor(active.id, doc, true);
      }
      syncEditorMode(active !== null);
      setSaveStatus("saved");
      focusEditorSoon();
    }

    function toggleMarkdownMode(): void {
      if (mdMode) void exitMarkdownMode();
      else void enterMarkdownMode();
    }

    // ── save status indicator ("Saving…" → "Saved ✓") ────────────────
    type SaveStatus = "idle" | "saving" | "saved";
    function setSaveStatus(s: SaveStatus): void {
      const el = $("save-status");
      if (savedFlashTimer) { clearTimeout(savedFlashTimer); savedFlashTimer = null; }
      if (s === "saving") {
        el.textContent = "Saving…";
        el.style.color = "var(--color-fg-subtle)";
      } else if (s === "saved") {
        el.textContent = "Saved ✓";
        el.style.color = "var(--color-success)";
        // Fade back to idle after a moment.
        savedFlashTimer = setTimeout(() => { el.textContent = ""; }, 1600);
      } else {
        el.textContent = "";
      }
    }

    // ── bubble toolbar wiring ──────────────────────────────────────────
    function wireBubbleToolbar(ed: Editor): void {
      bubbleEl.querySelectorAll<HTMLButtonElement>("[data-cmd]").forEach((btn) => {
        btn.addEventListener("mousedown", (e) => e.preventDefault()); // keep selection
        btn.addEventListener("click", () => {
          const cmd = btn.dataset.cmd;
          const chain = ed.chain().focus();
          if (cmd === "bold") chain.toggleBold().run();
          else if (cmd === "italic") chain.toggleItalic().run();
          else if (cmd === "strike") chain.toggleStrike().run();
          else if (cmd === "code") chain.toggleCode().run();
          else if (cmd === "link") toggleLink(ed);
          syncBubbleActive(ed);
        });
      });
      // Reflect active marks on selection change.
      ed.on("selectionUpdate", () => syncBubbleActive(ed));
      ed.on("transaction", () => syncBubbleActive(ed));
    }

    function syncBubbleActive(ed: Editor): void {
      const map: Record<string, string> = {
        bold: "bold", italic: "italic", strike: "strike", code: "code", link: "link",
      };
      bubbleEl.querySelectorAll<HTMLButtonElement>("[data-cmd]").forEach((btn) => {
        const mark = map[btn.dataset.cmd ?? ""];
        const active = mark ? ed.isActive(mark) : false;
        btn.classList.toggle("is-active", active);
      });
    }

    function toggleLink(ed: Editor): void {
      if (ed.isActive("link")) {
        ed.chain().focus().unsetLink().run();
        return;
      }
      const prev = (ed.getAttributes("link").href as string) ?? "";
      const url = window.prompt("Link URL", prev || "https://");
      if (url === null) return;          // cancelled
      if (url === "") { ed.chain().focus().unsetLink().run(); return; }
      ed.chain().focus().extendMarkRange("link").setLink({ href: url }).run();
    }

    // ── render ────────────────────────────────────────────────────────
    let toastTimer: ReturnType<typeof setTimeout> | null = null;

    /**
     * Append `text` to `el`, wrapping every case-insensitive occurrence of
     * `needle` in a <mark>. XSS-safe: all text goes through textContent /
     * createTextNode — never innerHTML — so a note titled `<img onerror>` stays
     * inert. Empty needle → plain text fast-path.
     */
    function highlightInto(el: HTMLElement, text: string, needle: string): void {
      if (!needle) {
        el.textContent = text;
        return;
      }
      const lower = text.toLowerCase();
      let from = 0;
      let idx = lower.indexOf(needle);
      if (idx === -1) {
        el.textContent = text;
        return;
      }
      const frag = document.createDocumentFragment();
      while (idx !== -1) {
        if (idx > from) frag.appendChild(document.createTextNode(text.slice(from, idx)));
        const mark = document.createElement("mark");
        mark.textContent = text.slice(idx, idx + needle.length);
        frag.appendChild(mark);
        from = idx + needle.length;
        idx = lower.indexOf(needle, from);
      }
      if (from < text.length) frag.appendChild(document.createTextNode(text.slice(from)));
      el.appendChild(frag);
    }

    /** Build one sticky-note card <li>. `needle` (lowercased) highlights hits. */
    function buildCard(
      entry: ReturnType<typeof notesStore.get>["index"][number],
      activeId: string | null,
      needle: string,
    ): HTMLLIElement {
      const sw = swatchOf(entry.color);
      const li = document.createElement("li");
      li.setAttribute("role", "option");
      li.setAttribute("aria-selected", String(entry.id === activeId));
      li.dataset.id = entry.id;
      li.tabIndex = 0;
      const selected = entry.id === activeId;
      li.className =
        "sticky-card group relative cursor-pointer rounded-lg border p-3 " +
        (selected ? "is-selected" : "");
      li.style.backgroundColor = sw.bg;
      li.style.borderColor = sw.edge;
      li.style.color = sw.ink;
      // Tilt lives in a custom prop so CSS can compose it with a hover lift.
      li.style.setProperty("--rot", `${rotationFor(entry.id)}deg`);
      // Glow (selected state) = the note's OWN colour. Derived from the saturated
      // edge swatch (the pale bg would be invisible as a glow on cream/gray/
      // pastels); alpha baked into rgba() in JS to dodge the minifier's color-mix
      // bug. Only the active card actually paints it (the .is-selected rule), but
      // setting the props only-when-selected keeps the others clean.
      if (selected) {
        const gl = glowVars(sw.edge);
        li.style.setProperty("--glow", gl.glow);
        li.style.setProperty("--glow-soft", gl.soft);
        li.style.setProperty("--glow-haze", gl.haze);
        li.style.setProperty("--glow-strong", gl.strong);
      }

      const titleRow = document.createElement("div");
      titleRow.className = "flex items-start gap-1.5";

      if (entry.pinned) {
        const pin = document.createElement("span");
        pin.textContent = "📌";
        pin.className = "shrink-0 text-xs leading-5";
        pin.setAttribute("aria-label", "Pinned");
        titleRow.appendChild(pin);
      }

      const title = document.createElement("div");
      title.className = "min-w-0 flex-1 truncate text-sm font-semibold";
      highlightInto(title, entry.title || "Untitled", needle);
      titleRow.appendChild(title);

      li.appendChild(titleRow);

      if (entry.preview) {
        const prev = document.createElement("div");
        prev.className = "mt-1 line-clamp-2 text-xs opacity-70";
        highlightInto(prev, entry.preview, needle);
        li.appendChild(prev);
      }

      return li;
    }

    /** A non-selectable group label row (e.g. "Pinned" / "Notes"). */
    function makeSectionHeader(label: string, count: number): HTMLLIElement {
      const li = document.createElement("li");
      li.setAttribute("role", "presentation");
      li.className = "section-header";
      const text = document.createElement("span");
      text.textContent = label;
      const badge = document.createElement("span");
      badge.className = "section-count";
      badge.textContent = String(count);
      li.append(text, badge);
      return li;
    }

    function render(state: ReturnType<typeof notesStore.get>): void {
      const query = state.query.trim();
      const needle = query.toLowerCase();
      const searching = needle.length > 0;
      const visible = searchNotes(state.index, state.query);
      // List vs empty vs no-results:
      //  - no notes at all → "fridge is empty" onboarding state
      //  - searching with zero matches → "no matches" state
      //  - otherwise → the list
      const hasNotes = state.index.length > 0;
      const noMatches = hasNotes && searching && visible.length === 0;
      const showList = hasNotes && !noMatches;
      listEl.classList.toggle("hidden", !showList);
      listEmptyEl.classList.toggle("hidden", hasNotes); // only for truly-empty
      listEmptyEl.classList.toggle("flex", !hasNotes);
      listNoResultsEl.classList.toggle("hidden", !noMatches);
      listNoResultsEl.classList.toggle("flex", noMatches);
      if (noMatches) noResultsQueryEl.textContent = query;

      // Build the rows. While searching we keep pure rank order (no grouping —
      // relevance matters more than pin status mid-search). Otherwise we group
      // Pinned above the rest, each with a labeled header (only when pins exist).
      const rows: HTMLLIElement[] = [];
      if (showList) {
        if (!searching) {
          const pinned = visible.filter((e) => e.pinned);
          const others = visible.filter((e) => !e.pinned);
          if (pinned.length > 0) {
            rows.push(makeSectionHeader("Pinned", pinned.length));
            for (const e of pinned) rows.push(buildCard(e, state.activeId, needle));
            // Only show the "Notes" header when there's a pinned group above it.
            if (others.length > 0) rows.push(makeSectionHeader("Notes", others.length));
          }
          for (const e of others) rows.push(buildCard(e, state.activeId, needle));
        } else {
          for (const e of visible) rows.push(buildCard(e, state.activeId, needle));
        }
      }
      listEl.replaceChildren(...rows);

      // Editor pane
      const hasActive = state.active !== null;
      // Mode-aware surface visibility (Preview = Tiptap host, Markdown = textarea).
      syncEditorMode(hasActive);
      editorEmptyEl.classList.toggle("hidden", hasActive);
      editorEmptyEl.classList.toggle("flex", !hasActive);
      toolbarEl.classList.toggle("hidden", !hasActive);
      toolbarEl.classList.toggle("flex", hasActive);

      if (state.active) {
        if (mdMode) {
          // In Markdown mode: when the selection changes to a different note,
          // re-serialize that note into the textarea. (Skip if it's the same
          // note we're already editing — never clobber the caret mid-type.)
          if (mdNoteId !== state.active.id) {
            mdNoteId = state.active.id;
            mdEditor.value = docToMarkdown(state.active.doc as JSONContent);
          }
        } else if (editorNoteId !== state.active.id) {
          // Preview mode: load this note's doc into the editor when the
          // selection changes. (No-op if the editor already holds this note —
          // avoids clobbering the caret while the user is typing in the same note.)
          void loadNoteIntoEditor(state.active.id, state.active.doc);
        }
        pinBtn.setAttribute("aria-pressed", String(state.active.pinned));
        pinBtn.style.color = state.active.pinned ? "var(--color-accent-strong)" : "";
        pinBtn.title = state.active.pinned ? "Unpin note" : "Pin note";
        // Reflect the active note's color on the toolbar dot + keep an open
        // picker's active ring in sync (e.g. when a sibling tab recolors it).
        const sw = swatchOf(state.active.color);
        colorBtnDot.style.background = sw.bg;
        // Drive the note's swatch onto the whole shell so the editor surface
        // (and, in PiP, the chrome) paints the literal note color — making the
        // float read as a native sticky. Text uses the swatch INK (near-black,
        // identical in light+dark) not the theme fg, else dark-mode text would
        // go white-on-pastel and vanish (same rule as the <mark> highlight).
        appRoot.style.setProperty("--note-bg", sw.bg);
        appRoot.style.setProperty("--note-ink", sw.ink);
        appRoot.style.setProperty("--note-edge", sw.edge);
        // Best-effort: point the address-bar/theme-color at the note color.
        // NOTE: browsers do NOT let a page recolor the Document-PiP title bar
        // (the dark padlock+URL+X strip) — that chrome is browser-owned with no
        // styling API. This only affects the mobile address bar / PWA theme on
        // platforms that honor it; the PiP title bar stays browser-default.
        setThemeColor(sw.bg);
        // Paint the float's own document root so overscroll never flashes white.
        paintPipRoot(sw.bg);
        if (isColorPopoverOpen()) syncColorPickerActive();
      } else {
        // Deselected — clear the editor's bound note so re-selecting reloads.
        editorNoteId = null;
        bubbleEl.style.visibility = "hidden";
        closeColorPopover();
        // Drop the note-color custom props so the empty state shows theme chrome.
        appRoot.style.removeProperty("--note-bg");
        appRoot.style.removeProperty("--note-ink");
        appRoot.style.removeProperty("--note-edge");
        resetThemeColor();
        paintPipRoot(null);
      }

      // Keep the in-PiP switcher (title / position / arrow-disabled / slide) in
      // sync on every state change. Cheap no-op work when not in PiP, but it
      // also keeps document.title tracking the active note (best-effort PiP
      // title-bar text — see syncPipSwitcher).
      syncPipSwitcher(state, visible);
    }

    // ── In-PiP note switcher ───────────────────────────────────────────────
    // The float hides the sidebar, so the switcher is the ONLY way to change
    // notes without bringing the app back. It lives in the header strip (empty
    // in PiP once brand + toggle are hidden) and shows the active note's title
    // — which doubles as the float's identity since the browser owns the PiP
    // title bar and won't let us style it. Prev/next reuse navigateList(±1).
    const BASE_TITLE = document.title; // "Notes · AlwaysOnTopNotes"
    let pipLastIndex = -1; // last active position in the visible list (for slide dir)
    function syncPipSwitcher(
      state: ReturnType<typeof notesStore.get>,
      visible: ReturnType<typeof searchNotes>,
    ): void {
      const active = state.active;
      const title = active?.title?.trim() || (active ? "Untitled" : "");

      // Best-effort PiP title-bar text: set document.title to the note title so
      // the OS window-switcher / taskbar shows it. NOTE: Chromium often forces
      // the ORIGIN (alwaysontopnotes.pages.dev) into the Document-PiP title bar
      // as an anti-spoofing measure, so this may not visibly change there — but
      // it's correct, harmless, and the switcher below surfaces the title in DOM
      // we fully control regardless.
      document.title = active ? `📺 ${title}` : BASE_TITLE;

      if (!active) {
        pipLastIndex = -1;
        pipTargetTitle = "";
        pipTitleText.textContent = "";
        pipPosEl.textContent = "";
        return;
      }

      const idx = visible.findIndex((e) => e.id === active.id);
      const total = visible.length;
      pipPosEl.textContent = total > 1 ? `${idx + 1} / ${total}` : "";
      // Disable arrows at the edges (don't wrap — matches navigateList's clamp).
      pipPrevBtn.disabled = idx <= 0;
      pipNextBtn.disabled = idx < 0 || idx >= total - 1;

      // 3D flip-board swap: tip the old title edge-on, swap text at the fold,
      // tip the new one in from the opposite edge (split-flap / departure board).
      // The counter micro-flips in sync so the cluster moves as one mechanism.
      const titleChanged = pipTargetTitle !== title;
      if (pipLastIndex !== -1 && idx !== -1 && idx !== pipLastIndex && titleChanged) {
        const dir = idx > pipLastIndex ? 1 : -1; // next → fold downward (away from viewer)
        requestTitleFlip(title, dir);
        playPosFlip();
      } else if (titleChanged) {
        // First paint, no movement, or same position → set directly (no flip).
        pipTargetTitle = title;
        pipTitleText.textContent = title;
      }
      pipLastIndex = idx;
    }

    // ── 3D flip-board animation (Web Animations API) ───────────────────────
    // Single-flight with latest-target reconcile: only ONE flip runs at a time.
    // The desired title lives in pipTargetTitle; the in-flight flip always paints
    // the LATEST target at the fold midpoint (never a stale captured value), and
    // if the target changed again during the fold it flips once more to catch up.
    // Result: spamming J/K can never strand a half-fold or land on a stale title
    // — the displayed title always reconciles to the active note.
    const prefersReducedMotion = (): boolean =>
      window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let pipTargetTitle = ""; // the title the switcher SHOULD show right now
    let flipping = false; // a flip is mid-flight
    let pendingDir: 1 | -1 = 1; // direction for the next reconcile flip
    function requestTitleFlip(nextTitle: string, dir: 1 | -1): void {
      pipTargetTitle = nextTitle;
      pendingDir = dir;
      // Reduced motion → instant swap, no 3D (movement is the opt-out; the title
      // still updates so the float stays usable).
      if (prefersReducedMotion()) {
        pipTitleText.textContent = nextTitle;
        return;
      }
      if (flipping) return; // the running flip will reconcile to the new target
      runFlip(dir);
    }
    function runFlip(dir: 1 | -1): void {
      flipping = true;
      // Perspective lives on the clip wrapper so the fold has real depth; the
      // button folds around its own horizontal mid-line.
      const clip = pipTitleBtn.parentElement;
      if (clip) clip.style.perspective = "320px";
      pipTitleBtn.style.transformOrigin = "center center";
      pipTitleBtn.style.backfaceVisibility = "hidden";
      pipTitleBtn.style.willChange = "transform, opacity";

      const out = dir === 1 ? -90 : 90; // next folds top-edge back; prev front
      const inFrom = dir === 1 ? 90 : -90;
      const FOLD = 150; // ms each half

      const half1 = pipTitleBtn.animate(
        [
          { transform: "rotateX(0deg)", opacity: 1 },
          { transform: `rotateX(${out}deg)`, opacity: 0 },
        ],
        { duration: FOLD, easing: "cubic-bezier(.45,0,.75,.25)", fill: "forwards" },
      );
      half1.onfinish = () => {
        // At the fold midpoint, paint the LATEST target (not a captured value).
        const painted = pipTargetTitle;
        pipTitleText.textContent = painted;
        const half2 = pipTitleBtn.animate(
          [
            { transform: `rotateX(${inFrom}deg)`, opacity: 0 },
            { transform: "rotateX(0deg)", opacity: 1 },
          ],
          { duration: FOLD, easing: "cubic-bezier(.25,.75,.55,1)", fill: "forwards" },
        );
        half2.onfinish = () => {
          // Released first so a reconcile flip starts from a clean resting state.
          pipTitleBtn.style.transform = "";
          pipTitleBtn.style.opacity = "";
          pipTitleBtn.style.willChange = "";
          flipping = false;
          // If the target moved on AFTER we painted the midpoint, flip once more
          // to catch up (compare against what we actually painted, not the live
          // textContent — which already equals `painted`).
          if (painted !== pipTargetTitle) runFlip(pendingDir);
        };
      };
    }

    // The N/M counter flips with the title — shorter + subtler so it reads as
    // part of the same mechanism without competing with the title.
    function playPosFlip(): void {
      if (prefersReducedMotion()) return;
      pipPosEl.style.transformOrigin = "center center";
      pipPosEl.style.backfaceVisibility = "hidden";
      pipPosEl.animate(
        [
          { transform: "rotateX(0deg)", opacity: 1, offset: 0 },
          { transform: "rotateX(-90deg)", opacity: 0.2, offset: 0.5 },
          { transform: "rotateX(0deg)", opacity: 1, offset: 1 },
        ],
        { duration: 300, easing: "ease-in-out" },
      );
    }

    // Tactile press: the arrow dips INTO the strip (and a hair toward travel)
    // on activation, like a real key. Pure transform, reduced-motion-aware.
    function pressArrow(btn: HTMLButtonElement, dir: 1 | -1): void {
      if (prefersReducedMotion()) return;
      const dx = dir === 1 ? 1.5 : -1.5;
      btn.animate(
        [
          { transform: "translateZ(0) scale(1)" },
          { transform: `translate(${dx}px, 0.5px) scale(0.86)`, offset: 0.45 },
          { transform: "translateZ(0) scale(1)" },
        ],
        { duration: 200, easing: "cubic-bezier(.3,1.4,.5,1)" },
      );
    }
    // Best-effort theme-color control. Updates a dedicated (non-media) meta so
    // platforms that honor it (mobile address bar, installed-PWA theme) track
    // the active note color. Does NOT affect the Document-PiP title bar — that
    // chrome is browser-owned and has no page-side styling API.
    let themeColorMeta: HTMLMetaElement | null = null;
    function ensureThemeColorMeta(): HTMLMetaElement {
      if (!themeColorMeta) {
        themeColorMeta = document.createElement("meta");
        themeColorMeta.setAttribute("name", "theme-color");
        themeColorMeta.setAttribute("data-note-theme", "1");
        document.head.appendChild(themeColorMeta);
      }
      return themeColorMeta;
    }
    function setThemeColor(color: string): void {
      ensureThemeColorMeta().setAttribute("content", color);
    }
    function resetThemeColor(): void {
      // Remove our override so the static media-gated metas in Layout win again.
      if (themeColorMeta) {
        themeColorMeta.remove();
        themeColorMeta = null;
      }
    }

    /** Paint the PiP float's <html> + <body> with the note color (or clear it).
     *  The float is a SEPARATE document; tinting only the moved #app-root leaves
     *  the float's own document root browser-default white, which rubber-bands
     *  into view on overscroll (the "white flash when you scroll past the end").
     *  Driving --note-bg onto the float's documentElement + body — consumed by
     *  the `:where(.pip-mode) html[style*="--note-bg"]` CSS — makes the color
     *  edge-to-edge so there's no white to reveal. No-op when not floating. */
    function paintPipRoot(bg: string | null): void {
      try {
        const win = pipWindowRef();
        if (!win || win.closed) return;
        const docEl = win.document.documentElement;
        const body = win.document.body;
        if (bg) {
          docEl.style.setProperty("--note-bg", bg);
          if (body) body.style.setProperty("--note-bg", bg);
        } else {
          docEl.style.removeProperty("--note-bg");
          if (body) body.style.removeProperty("--note-bg");
        }
      } catch {
        // The float can tear down mid-render; never let it break the app.
      }
    }

    // ── toast ──────────────────────────────────────────────────────────
    function showUndoToast(title: string): void {
      toastMsg.textContent = title ? `Deleted “${trim(title)}”` : "Note deleted";
      toastAction.textContent = "Undo";
      toastEl.classList.remove("hidden");
      if (toastTimer) clearTimeout(toastTimer);
      toastTimer = setTimeout(() => toastEl.classList.add("hidden"), 5000);
    }
    function hideToast(): void {
      if (toastTimer) clearTimeout(toastTimer);
      toastEl.classList.add("hidden");
    }
    // Lightweight transient toast WITHOUT an action button (import/export
    // feedback). Reuses the same element; hides the action so it reads as a
    // plain status pill, then auto-dismisses.
    function showInfoToast(message: string, ms = 3200): void {
      toastMsg.textContent = message;
      toastAction.textContent = "";
      toastAction.classList.add("hidden");
      toastEl.classList.remove("hidden");
      if (toastTimer) clearTimeout(toastTimer);
      toastTimer = setTimeout(() => {
        toastEl.classList.add("hidden");
        toastAction.classList.remove("hidden"); // restore for the undo toast
      }, ms);
    }
    const trim = (s: string): string => (s.length > 28 ? s.slice(0, 28) + "…" : s);

    // ── color picker ─────────────────────────────────────────────────────
    // Build the 8 semantic swatches once (UX-CHARTER §3). Each button sets the
    // active note's color; the label tooltip doubles as the soft taxonomy.
    function buildColorPicker(): void {
      colorGrid.replaceChildren(
        ...COLOR_ORDER.map((color) => {
          const sw = SWATCHES[color];
          const btn = document.createElement("button");
          btn.type = "button";
          btn.dataset.color = color;
          btn.setAttribute("role", "menuitemradio");
          btn.title = sw.label;
          btn.setAttribute("aria-label", sw.label);
          btn.className = "color-swatch";
          btn.style.background = sw.bg;
          btn.style.borderColor = sw.edge;
          return btn;
        }),
      );
    }

    function openColorPopover(): void {
      syncColorPickerActive();
      colorPopover.classList.remove("hidden");
      colorBtn.setAttribute("aria-expanded", "true");
    }
    function closeColorPopover(): void {
      colorPopover.classList.add("hidden");
      colorBtn.setAttribute("aria-expanded", "false");
    }
    const isColorPopoverOpen = (): boolean =>
      !colorPopover.classList.contains("hidden");

    // Ring + check the active note's current color in the grid.
    function syncColorPickerActive(): void {
      const cur = notesStore.get().active?.color ?? null;
      colorGrid
        .querySelectorAll<HTMLButtonElement>("[data-color]")
        .forEach((b) => b.classList.toggle("is-active", b.dataset.color === cur));
    }

    // ── shortcuts modal ──────────────────────────────────────────────────
    function openShortcuts(): void {
      shortcutsModal.classList.remove("hidden");
      shortcutsModal.classList.add("flex");
      shortcutsClose.focus();
    }
    function closeShortcuts(): void {
      shortcutsModal.classList.add("hidden");
      shortcutsModal.classList.remove("flex");
    }
    const isShortcutsOpen = (): boolean => !shortcutsModal.classList.contains("hidden");

    // ── J/K list navigation ──────────────────────────────────────────────
    // Move the selection down (+1) or up (-1) through the CURRENTLY VISIBLE,
    // search-filtered, sorted list — mirrors exactly what the sidebar shows
    // (so navigation matches the user's eyes, including during a search).
    function navigateList(delta: 1 | -1): void {
      const state = notesStore.get();
      const visible = searchNotes(state.index, state.query);
      if (visible.length === 0) return;
      const curIdx = visible.findIndex((e) => e.id === state.activeId);
      // No selection yet → J picks the first, K picks the last.
      let nextIdx: number;
      if (curIdx === -1) {
        nextIdx = delta === 1 ? 0 : visible.length - 1;
      } else {
        nextIdx = curIdx + delta;
        if (nextIdx < 0 || nextIdx >= visible.length) return; // clamp at edges
      }
      const next = visible[nextIdx];
      void notesStore.selectNote(next.id);
      // Keep the newly-selected card in view (it may be below the fold).
      requestAnimationFrame(() => {
        listEl
          .querySelector<HTMLElement>(`li[data-id="${next.id}"]`)
          ?.scrollIntoView({ block: "nearest" });
      });
    }

    // ── event wiring ────────────────────────────────────────────────────

    /** Focus the editor once it exists (created lazily on first select). */
    function focusEditorSoon(): void {
      const tryFocus = () => {
        if (editor) editor.commands.focus("end");
        else requestAnimationFrame(tryFocus);
      };
      requestAnimationFrame(tryFocus);
    }

    // ── Document Picture-in-Picture (Phase 3) ─────────────────────────
    // Pops the whole #app-root shell into a floating always-on-top window.
    // Feature-gated to Chromium 116+; the button stays hidden elsewhere.
    const pipToggle = $<HTMLButtonElement>("pip-toggle");
    const pipIconOpen = $("pip-icon-open");
    const pipIconClose = $("pip-icon-close");
    const pipPlaceholder = $("pip-placeholder");
    const pipBringBack = $<HTMLButtonElement>("pip-bring-back");
    const appRoot = $("app-root");

    function setPipUi(open: boolean): void {
      pipIconOpen.classList.toggle("hidden", open);
      pipIconClose.classList.toggle("hidden", !open);
      const label = open ? "Bring back to this tab" : "Pop out into a floating window";
      pipToggle.setAttribute("aria-label", label);
      pipToggle.setAttribute("title", label);
      // Placeholder uses `hidden flex-col`; add `flex` when shown (mirrors the
      // list-empty/editor-empty toggle pattern in render()).
      pipPlaceholder.classList.toggle("flex", open);
    }

    // Default PiP size (DECISION 7-A — sticky-note proportions). Per-note saved
    // size overrides this on a per-note basis.
    const PIP_DEFAULT_W = 400;
    const PIP_DEFAULT_H = 500;
    let pipResizeCleanup: (() => void) | null = null;

    async function togglePip(): Promise<void> {
      if (isPipOpen()) {
        closePip(); // pagehide → onClose → setPipUi(false)
        return;
      }
      // Open at the active note's saved size if it has one, else the default.
      const active = notesStore.get().active;
      const width = active?.pipWidth ?? PIP_DEFAULT_W;
      const height = active?.pipHeight ?? PIP_DEFAULT_H;
      let pipDoc: Document | null = null; // captured in onOpen for onClose unbind
      const handle = await openPip({
        sourceEl: appRoot,
        placeholderEl: pipPlaceholder,
        width,
        height,
        pipTitle: `📺 ${document.title}`,
        onOpen: (pipWindow) => {
          pipDoc = pipWindow.document;
          // 1) Reparenting blurs the focused contentEditable — re-focus so the
          //    user can type immediately in the floating note.
          if (notesStore.get().activeId) focusEditorSoon();
          // 1b) Paint the freshly-created float document root with the active
          //     note color NOW (render() may not fire again until a state
          //     change) so overscroll never flashes the browser-default white.
          const act = notesStore.get().active;
          paintPipRoot(act ? swatchOf(act.color).bg : null);
          // 2) Bind the keymap + outside-click onto the PiP document so all
          //    shortcuts (N/J/K/?/Esc/Cmd+S) work INSIDE the float.
          bindGlobalListeners(pipWindow.document);
          // 3) Persist the window size per-note on resize (debounced). A resize
          //    is per-device chrome, not content — updateNoteSize writes quietly
          //    (no updatedAt bump, no broadcast, no "Saved ✓").
          let resizeTimer: ReturnType<typeof setTimeout> | null = null;
          const onResize = () => {
            if (resizeTimer) clearTimeout(resizeTimer);
            resizeTimer = setTimeout(() => {
              const id = notesStore.get().activeId;
              if (!id) return;
              void notesStore.updateNoteSize(
                id,
                pipWindow.innerWidth,
                pipWindow.innerHeight,
              );
            }, 400);
          };
          pipWindow.addEventListener("resize", onResize);
          pipResizeCleanup = () => {
            if (resizeTimer) clearTimeout(resizeTimer);
            pipWindow.removeEventListener("resize", onResize);
          };
        },
        onClose: () => {
          setPipUi(false);
          // Close the stack switcher if it was left open — it's a PiP-only
          // surface and shouldn't linger when the app returns to the tab.
          pipStack.close();
          // Unbind PiP-doc listeners + tear down the resize watcher. The PiP
          // document dies on close (its listeners go with it), but we still
          // drop it from boundDocs so the Set never holds a stale Document.
          if (pipResizeCleanup) {
            pipResizeCleanup();
            pipResizeCleanup = null;
          }
          if (pipDoc) {
            unbindGlobalListeners(pipDoc);
            pipDoc = null;
          }
        },
      });
      if (!handle) {
        // Surface the popup-blocked / rejected case as a transient notice.
        toastMsg.textContent =
          "Couldn't open the floating window. Allow pop-ups for this site.";
        toastAction.textContent = "";
        toastEl.classList.remove("hidden");
        if (toastTimer) clearTimeout(toastTimer);
        toastTimer = setTimeout(() => toastEl.classList.add("hidden"), 4000);
        return;
      }
      setPipUi(true);
    }

    if (isPipSupported()) {
      pipToggle.classList.remove("hidden");
      pipToggle.addEventListener("click", () => void togglePip());
      pipBringBack.addEventListener("click", () => {
        if (isPipOpen()) closePip();
      });
      // First-run pointer at the (now-visible) PiP button. Self-gates on the
      // localStorage sticky bit + a ~2.8s delay so it never fights the welcome
      // note. No-ops for returning users / unsupported browsers.
      initPipTour();
    }

    // PWA install pill (Phase 4 · commit 16). Captures beforeinstallprompt /
    // shows the custom install UI / iOS A2HS hint. Self-gates on installed +
    // 14-day dismiss cooldown; safe to call before DOM-ready (only attaches
    // listeners + a deferred iOS timer).
    initPwaInstall();

    // Theme toggle (Phase 4 · commit 17). Header button cycling dark → light →
    // system; persists the choice to aotn:theme, tracks the OS live in system
    // mode, and re-mirrors data-theme onto an open PiP float. Icons swapped in
    // JS (data-theme project — dark:* utilities would no-op).
    initThemeToggle({
      button: $("theme-toggle"),
      icons: {
        dark: document.getElementById("theme-icon-dark"),
        light: document.getElementById("theme-icon-light"),
        system: document.getElementById("theme-icon-system"),
      },
      pipWindowRef,
    });

    // PiP 3D stack switcher. A richer note picker for the float (the sidebar is
    // hidden there): a vertical 3D deck you flick through (wheel / ↑↓ / J K) and
    // tap to jump to ANY note. Selecting routes through selectNote + refocuses
    // the editor, same as navigateList. The host lives inside #app-root so it
    // travels into PiP; it's inert in the two-pane app (hidden via .pip-mode CSS).
    const pipStack = initPipStack({
      host: $("pip-stack"),
      toggleBtn: $("pip-stack-toggle"),
      getVisible: () => {
        const s = notesStore.get();
        return searchNotes(s.index, s.query);
      },
      getActiveId: () => notesStore.get().activeId,
      swatchOf,
      rotationFor,
      onSelect: (id) => {
        void notesStore.selectNote(id);
        focusEditorSoon();
      },
    });

    // In-PiP note switcher buttons. Prev = K = up (-1), Next = J = down (+1) —
    // same direction semantics as the keyboard nav they mirror. The title acts
    // as a "bring the app back" affordance (the sidebar is the richer switcher).
    pipPrevBtn.addEventListener("click", () => {
      pressArrow(pipPrevBtn, -1);
      navigateList(-1);
    });
    pipNextBtn.addEventListener("click", () => {
      pressArrow(pipNextBtn, 1);
      navigateList(1);
    });
    pipTitleBtn.addEventListener("click", () => {
      if (isPipOpen()) closePip();
    });

    newBtn.addEventListener("click", () => {
      void notesStore.createNote();
      focusEditorSoon();
    });

    searchEl.addEventListener("input", () => notesStore.setQuery(searchEl.value));

    listEl.addEventListener("click", (e) => {
      const li = (e.target as HTMLElement).closest("li[data-id]") as HTMLElement | null;
      if (li?.dataset.id) void notesStore.selectNote(li.dataset.id);
    });
    listEl.addEventListener("keydown", (e) => {
      if (e.key !== "Enter" && e.key !== " ") return;
      const li = (e.target as HTMLElement).closest("li[data-id]") as HTMLElement | null;
      if (li?.dataset.id) {
        e.preventDefault();
        void notesStore.selectNote(li.dataset.id);
        focusEditorSoon();
      }
    });

    pinBtn.addEventListener("click", () => {
      const id = notesStore.get().activeId;
      if (id) void notesStore.togglePin(id);
    });

    deleteBtn.addEventListener("click", () => {
      const id = notesStore.get().activeId;
      if (id) void notesStore.deleteNote(id);
    });

    // ── Export / import (Phase 4 commit 15) ───────────────────────────────
    // Single-note export: download the active note as Markdown.
    exportBtn.addEventListener("click", () => {
      const active = notesStore.get().active;
      if (active) exportNote(active);
    });

    // Markdown edit-mode toggle + textarea autosave.
    mdToggleBtn.addEventListener("click", () => {
      if (!notesStore.get().active) return; // nothing to edit
      toggleMarkdownMode();
    });
    mdEditor.addEventListener("input", () => {
      if (mdMode) scheduleMdSave(mdEditor.value);
    });

    // Overflow menu open/close.
    function openMoreMenu(): void {
      moreMenu.classList.remove("hidden");
      moreBtn.setAttribute("aria-expanded", "true");
    }
    function closeMoreMenu(): void {
      moreMenu.classList.add("hidden");
      moreBtn.setAttribute("aria-expanded", "false");
    }
    const isMoreMenuOpen = (): boolean => !moreMenu.classList.contains("hidden");
    moreBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      if (isMoreMenuOpen()) closeMoreMenu();
      else openMoreMenu();
    });

    // Export all notes as a .zip.
    exportAllBtn.addEventListener("click", async () => {
      closeMoreMenu();
      const notes = await notesStore.getAllNotes();
      if (notes.length === 0) {
        showInfoToast("No notes to export");
        return;
      }
      try {
        await exportAllNotes(notes);
        showInfoToast(`Exported ${notes.length} ${notes.length === 1 ? "note" : "notes"} (.zip)`);
      } catch {
        showInfoToast("Export failed");
      }
    });

    // Import: open the file picker.
    importBtn.addEventListener("click", () => {
      closeMoreMenu();
      importInput.click();
    });

    // Shared import path for both picker + drag-drop. Seeds one note per file.
    async function runImport(files: File[]): Promise<void> {
      if (files.length === 0) return;
      const summary = await importMarkdownFiles(files, (doc) =>
        notesStore.seedNote(doc),
      );
      const parts: string[] = [];
      if (summary.imported > 0) {
        parts.push(`Imported ${summary.imported} ${summary.imported === 1 ? "note" : "notes"}`);
      }
      if (summary.skipped > 0) parts.push(`${summary.skipped} skipped`);
      showInfoToast(parts.join(" · ") || "Nothing to import");
      if (summary.imported > 0) focusEditorSoon();
    }

    importInput.addEventListener("change", () => {
      const files = Array.from(importInput.files ?? []);
      void runImport(files);
      importInput.value = ""; // allow re-importing the same file later
    });

    // Drag-drop import. Show the overlay while a file is dragged over the window;
    // a depth counter avoids flicker as dragenter/leave fire on child elements.
    let dragDepth = 0;
    const hasFiles = (e: DragEvent): boolean =>
      Array.from(e.dataTransfer?.types ?? []).includes("Files");
    window.addEventListener("dragenter", (e) => {
      if (!hasFiles(e)) return;
      e.preventDefault();
      dragDepth += 1;
      dropOverlay.classList.remove("hidden");
      dropOverlay.classList.add("flex");
    });
    window.addEventListener("dragover", (e) => {
      if (hasFiles(e)) e.preventDefault(); // required so 'drop' fires
    });
    window.addEventListener("dragleave", (e) => {
      if (!hasFiles(e)) return;
      dragDepth = Math.max(0, dragDepth - 1);
      if (dragDepth === 0) {
        dropOverlay.classList.add("hidden");
        dropOverlay.classList.remove("flex");
      }
    });
    window.addEventListener("drop", (e) => {
      dragDepth = 0;
      dropOverlay.classList.add("hidden");
      dropOverlay.classList.remove("flex");
      if (!e.dataTransfer) return;
      e.preventDefault();
      const files = Array.from(e.dataTransfer.files);
      void runImport(files);
    });

    // Color picker: toggle popover, pick a swatch, dismiss on outside-click/Esc.
    buildColorPicker();
    colorBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      if (isColorPopoverOpen()) closeColorPopover();
      else openColorPopover();
    });
    colorGrid.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-color]");
      const color = btn?.dataset.color as StickyColor | undefined;
      const id = notesStore.get().activeId;
      if (color && id) {
        void notesStore.setColor(id, color);
        closeColorPopover();
      }
    });
    // Outside-click closes the popover (works in whichever document has focus —
    // bound to both origin + PiP doc via bindGlobalListeners).
    function onDocClick(e: MouseEvent): void {
      const t = e.target as Node;
      if (isColorPopoverOpen() && !colorPopover.contains(t) && !colorBtn.contains(t)) {
        closeColorPopover();
      }
      if (isMoreMenuOpen() && !moreMenu.contains(t) && !moreBtn.contains(t)) {
        closeMoreMenu();
      }
    }
    document.addEventListener("click", onDocClick);

    // Shortcuts modal: close via the × button or a backdrop click.
    shortcutsClose.addEventListener("click", closeShortcuts);
    shortcutsBackdrop.addEventListener("click", closeShortcuts);

    toastAction.addEventListener("click", () => {
      notesStore.undoDelete();
      hideToast();
    });

    notesStore.emitter.on("pendingDelete", ({ title }) => showUndoToast(title));

    // Flash "Saved ✓" when a persist completes (store flips saving true→false).
    let wasSaving = false;
    notesStore.emitter.on("change", (s) => {
      if (wasSaving && !s.saving) setSaveStatus("saved");
      wasSaving = s.saving;
    });

    // Surface a persist failure as a toast.
    notesStore.emitter.on("error", ({ message }) => {
      toastMsg.textContent = message;
      toastAction.textContent = "";
      toastEl.classList.remove("hidden");
      if (toastTimer) clearTimeout(toastTimer);
      toastTimer = setTimeout(() => toastEl.classList.add("hidden"), 4000);
    });

    // Surface a cross-tab info notice (e.g. "deleted in another tab").
    notesStore.emitter.on("notice", ({ message }) => {
      toastMsg.textContent = message;
      toastAction.textContent = "";
      toastEl.classList.remove("hidden");
      if (toastTimer) clearTimeout(toastTimer);
      toastTimer = setTimeout(() => toastEl.classList.add("hidden"), 4000);
    });

    // A sibling tab edited the note we're viewing. Reload the editor body to
    // reflect it — but ONLY if the user isn't mid-edit (no pending debounce),
    // so we never yank the caret out from under active typing (§7 limitation:
    // simultaneous same-note typing is still last-saver-wins).
    notesStore.emitter.on("remoteActive", ({ id, doc }) => {
      if (saveDebounce) return; // user is actively typing — don't clobber
      if (mdMode) {
        // Markdown mode: refresh the textarea from the sibling tab's edit.
        mdNoteId = id;
        mdEditor.value = docToMarkdown(doc as JSONContent);
        return;
      }
      void loadNoteIntoEditor(id, doc as JSONContent, true);
    });

    // Keyboard map (Phase 2 subset — SPEC-Phase2 §8). Named so it can be bound
    // to BOTH the origin document AND the PiP document (a PiP window is a
    // separate document; the origin listener never sees keys typed in the
    // float — see bindGlobalListeners).
    function onKeyDown(e: KeyboardEvent): void {
      // CRITICAL: read activeElement from the event's OWN document, not the
      // hardcoded origin `document`. When a key fires inside the PiP window the
      // focused editor lives in the PiP doc; using origin `document` here would
      // report `typing=false` and fire N/J/K while the user is mid-sentence.
      const srcDoc =
        (e.target as Node | null)?.ownerDocument ??
        (e.view as Window | null)?.document ??
        document;
      const el = srcDoc.activeElement as HTMLElement | null;
      const typing =
        el &&
        (el.tagName === "INPUT" ||
          el.tagName === "TEXTAREA" ||
          el.isContentEditable); // .ProseMirror is contentEditable → covered

      // ── Escape: close the topmost overlay, context-aware ──────────────
      if (e.key === "Escape") {
        if (isShortcutsOpen()) {
          e.preventDefault();
          closeShortcuts();
          return;
        }
        if (isColorPopoverOpen()) {
          e.preventDefault();
          closeColorPopover();
          return;
        }
        if (el === searchEl) {
          e.preventDefault();
          if (searchEl.value) {
            searchEl.value = "";
            notesStore.setQuery("");
          } else {
            searchEl.blur();
          }
          return;
        }
      }

      // ── Cmd/Ctrl shortcuts: work EVEN while typing in the editor ───────
      if (e.metaKey || e.ctrlKey) {
        const k = e.key.toLowerCase();
        if (k === "s") {
          // Force save: flush the pending debounce now + flash "Saved ✓". The
          // note already autosaves, but Cmd+S is muscle memory → reassurance.
          e.preventDefault();
          if (saveDebounce && editor) {
            clearTimeout(saveDebounce);
            saveDebounce = null;
            void notesStore.updateActiveDoc(editor.getJSON() as JSONContent);
          }
          setSaveStatus("saved");
          return;
        }
        if (e.key === "Backspace") {
          // Delete the current note → 5s undo toast (§6).
          const id = notesStore.get().activeId;
          if (id) {
            e.preventDefault();
            void notesStore.deleteNote(id);
          }
          return;
        }
        return; // leave all other Cmd/Ctrl combos to Tiptap / the browser
      }

      // ── `?` opens the shortcuts modal (allowed even when not typing) ───
      // `?` is Shift+/ on most layouts; gate on the produced char, not the code.
      if (e.key === "?" && !typing) {
        e.preventDefault();
        if (isShortcutsOpen()) closeShortcuts();
        else openShortcuts();
        return;
      }

      // ── Single-key shortcuts: only when NOT typing ────────────────────
      if (typing) return;
      if (e.key === "n" || e.key === "N") {
        e.preventDefault();
        void notesStore.createNote();
        focusEditorSoon();
      } else if (e.key === "/") {
        e.preventDefault();
        searchEl.focus();
        searchEl.select();
      } else if (e.key === "j" || e.key === "J" || e.key === "ArrowDown") {
        e.preventDefault();
        navigateList(1);
      } else if (e.key === "k" || e.key === "K" || e.key === "ArrowUp") {
        e.preventDefault();
        navigateList(-1);
      }
    }
    document.addEventListener("keydown", onKeyDown);

    // Bind/unbind the global listeners onto an arbitrary document. Used to
    // make the keymap + outside-click work INSIDE the PiP window (a separate
    // document). The origin document keeps its own binding the whole time, so
    // the sidebar still responds if focused there. `boundDocs` guards against
    // double-binding the same document.
    const boundDocs = new Set<Document>([document]);
    function bindGlobalListeners(doc: Document): void {
      if (boundDocs.has(doc)) return;
      boundDocs.add(doc);
      doc.addEventListener("keydown", onKeyDown as EventListener);
      doc.addEventListener("click", onDocClick as EventListener);
    }
    function unbindGlobalListeners(doc: Document): void {
      if (doc === document) return; // never unbind the origin
      boundDocs.delete(doc);
      doc.removeEventListener("keydown", onKeyDown as EventListener);
      doc.removeEventListener("click", onDocClick as EventListener);
    }

    // Flush any pending hard-delete + pending save before the tab unloads.
    window.addEventListener("pagehide", () => {
      if (saveDebounce && editor) {
        clearTimeout(saveDebounce);
        void notesStore.updateActiveDoc(editor.getJSON() as JSONContent);
      }
      notesStore.flushPendingDelete();
    });

    // ── boot ────────────────────────────────────────────────────────────
    notesStore.emitter.on("change", render);
    (async () => {
      const adapter = await pickStorage();
      await notesStore.init(adapter);
      // First-run welcome note (UX-CHARTER §empty). Seed only when the user has
      // NO notes AND hasn't been welcomed before — so we never inject it on top
      // of real notes, and it never re-appears after they delete/dismiss it.
      if (!hasWelcomed() && notesStore.get().index.length === 0) {
        markWelcomed();
        void notesStore.seedNote(welcomeDoc() as JSONContent, WELCOME_COLOR);
      }
      render(notesStore.get());
    })();
  </script>
</Layout>
