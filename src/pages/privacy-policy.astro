---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { site } from "../site.config";

/**
 * /privacy-policy — the LEGAL privacy document (GDPR/CCPA structured). Required
 * for AdSense approval. Distinct from any technical "privacy by design" explainer.
 * Covers: data controller, what is + isn't collected, the on-device storage model,
 * cookies (GA4 + potential AdSense), third parties, rights, retention, contact.
 * All operator-specific values come from site.config.ts.
 */

const lastUpdated = "June 14, 2026";

// WebPage JSON-LD (no dedicated Schema.org PrivacyPolicy type) — layered on top
// of the sitewide Organization + WebSite graph.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: `Privacy Policy — ${site.name}`,
  url: `${site.url}/privacy-policy`,
  description: `How ${site.name} handles your data: notes stay on your device, analytics are anonymous, and your rights under GDPR and CCPA.`,
  dateModified: "2026-06-14",
  publisher: { "@id": `${site.url}/#organization` },
};
---

<Layout
  title="Privacy Policy"
  description="AlwaysOnTopNotes privacy policy — your notes stay on your device, never uploaded. What we do and don't collect, cookies, third parties, and your GDPR/CCPA rights."
  jsonLd={[jsonLd]}
>
  <Nav />

  <main class="mx-auto max-w-[760px] px-6 py-16 md:px-8 md:py-24">
    <header>
      <h1 class="text-4xl font-bold tracking-tight text-[var(--color-fg)] md:text-5xl">
        Privacy Policy
      </h1>
      <p class="mt-4 text-sm text-[var(--color-fg-subtle)]">
        Last updated: {lastUpdated}
      </p>
      <p class="mt-6 rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-subtle)] p-5 text-base leading-relaxed text-[var(--color-fg-muted)]">
        <strong class="font-semibold text-[var(--color-fg)]">The short version:</strong>
        your notes are stored only in your browser, on your device. We never
        receive, upload, or store them. We can't read what we don't have. The
        only data we see is anonymous, aggregate website analytics.
      </p>
    </header>

    <div class="prose mt-12 max-w-none space-y-10">
      <section>
        <h2 class="text-2xl font-bold tracking-tight text-[var(--color-fg)]">1. Who we are</h2>
        <p class="mt-3 text-base leading-relaxed text-[var(--color-fg-muted)]">
          {site.name} (“we”, “us”, “our”) is a free, client-side web
          application operated by {site.author}. For any privacy question or
          request, contact us at
          <a href={`mailto:${site.contactEmail}`} class="prose-link">{site.contactEmail}</a>.
          This policy explains what data is and isn't processed when you use
          {site.name} at {site.domain}.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-bold tracking-tight text-[var(--color-fg)]">
          2. Your notes never leave your device
        </h2>
        <p class="mt-3 text-base leading-relaxed text-[var(--color-fg-muted)]">
          {site.name} is a fully client-side app. Every note you create is stored
          locally in your browser using <strong class="font-semibold text-[var(--color-fg)]">IndexedDB</strong>,
          a standard on-device storage mechanism. Your note content:
        </p>
        <ul class="mt-4 list-disc space-y-2 pl-6 text-base leading-relaxed text-[var(--color-fg-muted)]">
          <li>is never transmitted to us or to any server;</li>
          <li>is never stored, backed up, or processed on our infrastructure;</li>
          <li>cannot be read by us, because we never receive it;</li>
          <li>stays on your device until you delete it or clear your browser data.</li>
        </ul>
        <p class="mt-4 text-base leading-relaxed text-[var(--color-fg-muted)]">
          There is no server-side account, database, or sync. The entire app is
          static files served from a content-delivery network. You can verify
          this in the
          <a href={site.githubRepo} target="_blank" rel="noopener" class="prose-link">open-source code</a>
          or by watching your browser's Network tab while you save a note.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-bold tracking-tight text-[var(--color-fg)]">
          3. Information we do process
        </h2>
        <p class="mt-3 text-base leading-relaxed text-[var(--color-fg-muted)]">
          To run and improve the website, a limited amount of standard,
          non-content data is processed:
        </p>
        <ul class="mt-4 list-disc space-y-2 pl-6 text-base leading-relaxed text-[var(--color-fg-muted)]">
          <li>
            <strong class="font-semibold text-[var(--color-fg)]">Anonymous analytics.</strong>
            We use Google Analytics 4 to count page views and understand broad
            usage (e.g. which pages are popular, rough country, device type). This
            is aggregate and anonymized — it is never linked to your note content,
            which we don't have access to.
          </li>
          <li>
            <strong class="font-semibold text-[var(--color-fg)]">Server logs.</strong>
            Our hosting/CDN provider (Cloudflare) may automatically log standard
            request metadata such as IP address and user-agent for security and
            abuse-prevention, as is typical for any website.
          </li>
        </ul>
      </section>

      <section>
        <h2 class="text-2xl font-bold tracking-tight text-[var(--color-fg)]">4. Cookies and similar technologies</h2>
        <p class="mt-3 text-base leading-relaxed text-[var(--color-fg-muted)]">
          The {site.name} app itself stores nothing about you on our servers. We
          use your browser's local storage only to keep your notes and to
          remember your own preferences (such as your light/dark theme choice).
          Your note content is never read for analytics or advertising. The
          website around the app, however, does load third-party scripts that set
          cookies — measurement, and advertising if ads are shown.
        </p>
        <p class="mt-4 text-base leading-relaxed text-[var(--color-fg-muted)]">
          Third-party services we load may set cookies:
        </p>
        <ul class="mt-4 list-disc space-y-2 pl-6 text-base leading-relaxed text-[var(--color-fg-muted)]">
          <li>
            <strong class="font-semibold text-[var(--color-fg)]">Google Analytics</strong>
            sets cookies to measure aggregate usage. See
            <a href="https://policies.google.com/privacy" target="_blank" rel="noopener" class="prose-link">Google's Privacy Policy</a>.
          </li>
          <li>
            <strong class="font-semibold text-[var(--color-fg)]">Advertising (if shown).</strong>
            We may display ads served by Google AdSense. Third-party vendors,
            including Google, use cookies to serve ads based on your prior visits
            to this and other websites. Google's use of advertising cookies
            enables it and its partners to serve ads to you based on your visits.
            You can opt out of personalized advertising by visiting
            <a href="https://www.google.com/settings/ads" target="_blank" rel="noopener" class="prose-link">Google Ads Settings</a>,
            or opt out of some third-party vendors' use of cookies at
            <a href="https://www.aboutads.info/choices/" target="_blank" rel="noopener" class="prose-link">aboutads.info/choices</a>.
          </li>
        </ul>
        <p class="mt-4 text-base leading-relaxed text-[var(--color-fg-muted)]">
          More specifically: we may display ads served by
          <strong class="font-semibold text-[var(--color-fg)]">Google AdSense</strong>.
          Google, as a third-party vendor, uses cookies to serve ads on this
          site. Google's use of the <strong class="font-semibold text-[var(--color-fg)]">DART cookie</strong>
          enables it and its partners to serve ads to users based on their prior
          visits to this and other websites on the internet. Other third-party
          vendors and ad networks may likewise use cookies for the same purpose.
          You may opt out of the DART cookie and personalized advertising by
          visiting the
          <a href="https://www.google.com/settings/ads" target="_blank" rel="noopener" class="prose-link">Google Ads Settings page</a>,
          and you may opt out of some third-party vendors' use of cookies for
          personalized advertising at
          <a href="https://www.aboutads.info/choices/" target="_blank" rel="noopener" class="prose-link">www.aboutads.info/choices</a>.
          Opting out does not remove ads — it makes them less relevant. None of
          this touches your notes, which never leave your device.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-bold tracking-tight text-[var(--color-fg)]">5. Third-party services</h2>
        <p class="mt-3 text-base leading-relaxed text-[var(--color-fg-muted)]">
          We rely on a small set of reputable providers: <strong class="font-semibold text-[var(--color-fg)]">Cloudflare</strong>
          (hosting and content delivery), <strong class="font-semibold text-[var(--color-fg)]">Google Analytics</strong>
          (anonymous usage measurement), and potentially <strong class="font-semibold text-[var(--color-fg)]">Google AdSense</strong>
          (advertising). Each processes data under its own privacy policy. We do
          not sell your personal information.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-bold tracking-tight text-[var(--color-fg)]">6. Your rights (GDPR &amp; CCPA)</h2>
        <p class="mt-3 text-base leading-relaxed text-[var(--color-fg-muted)]">
          Because your notes live only on your device, you already have complete
          control: you can view, edit, export (as Markdown), or permanently delete
          them at any time, directly in the app. For the limited analytics data
          processed by our providers, and depending on your jurisdiction (e.g. the
          EU/UK under GDPR, or California under the CCPA), you may have the right
          to access, correct, delete, or restrict processing of your personal
          data, and to object to it.
        </p>
        <p class="mt-4 text-base leading-relaxed text-[var(--color-fg-muted)]">
          To exercise any of these rights, email
          <a href={`mailto:${site.contactEmail}`} class="prose-link">{site.contactEmail}</a>.
          You also have the right to lodge a complaint with your local data
          protection authority.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-bold tracking-tight text-[var(--color-fg)]">7. Children's privacy</h2>
        <p class="mt-3 text-base leading-relaxed text-[var(--color-fg-muted)]">
          {site.name} is a general-purpose productivity tool and is not directed
          at children under 13. We do not knowingly collect personal information
          from children.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-bold tracking-tight text-[var(--color-fg)]">8. Changes to this policy</h2>
        <p class="mt-3 text-base leading-relaxed text-[var(--color-fg-muted)]">
          We may update this policy from time to time. Material changes will be
          reflected by the “Last updated” date above. Continued use of
          {site.name} after a change constitutes acceptance of the revised policy.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-bold tracking-tight text-[var(--color-fg)]">9. Contact</h2>
        <p class="mt-3 text-base leading-relaxed text-[var(--color-fg-muted)]">
          Questions about this policy or your data? Email
          <a href={`mailto:${site.contactEmail}`} class="prose-link">{site.contactEmail}</a>
          or open an issue on
          <a href={site.githubRepo} target="_blank" rel="noopener" class="prose-link">GitHub</a>.
          See also our <a href="/terms" class="prose-link">Terms &amp; Conditions</a>.
        </p>
      </section>
    </div>
  </main>

  <Footer />
</Layout>
